--- Kiểm tra object validity
---@param obj any: Object cần kiểm tra
---@return boolean
local function IsValid(obj)
    if type(obj) ~= "userdata" then return false end
    local success, result = pcall(function()
        return obj and obj.Parent ~= nil
    end)
    return success and result == true
end

--- Tính khoảng cách giữa 2 Vector3
---@param a Vector3
---@param b Vector3
---@return number
local function Distance(a, b)
    if not a or not b then return math.huge end
    return (a - b).Magnitude
end

--- Lấy character của player
---@param player Player
---@return Model|nil
local function GetCharacter(player)
    if not IsValid(player) then return nil end
    return player.Character or player.CharacterAdded:Wait()
end

--- Lấy Humanoid từ character
---@param char Model
---@return Humanoid|nil
local function GetHumanoid(char)
    if not IsValid(char) then return nil end    return char:FindFirstChildOfClass("Humanoid")
end

--- Lấy RootPart (HumanoidRootPart hoặc Torso)
---@param char Model
---@return BasePart|nil
local function GetRootPart(char)
    local hum = GetHumanoid(char)    if not hum then return nil end
    return hum.RootPart or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

--- Lấy vị trí player
---@param player Player
---@return Vector3|nil
local function GetPosition(player)
    local char = GetCharacter(player)
    local root = GetRootPart(char)
    return root and root.Position
end

--- Kiểm tra player còn sống không
---@param player Player
---@return boolean
local function IsAlive(player)
    local hum = GetHumanoid(GetCharacter(player))
    return hum and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead
end

--- Kiểm tra có phải team mình không (dùng Easy.gg TeamService hoặc fallback)
---@param player Player
---@return boolean
local function IsTeammate(player)
    -- Thử lấy team info từ Easy.gg
    pcall(function()
        local TeamService = getrenv().TeamService
        if TeamService then
            local myTeam = TeamService.getTeam(LocalPlayer)
            local theirTeam = TeamService.getTeam(player)
            return myTeam and theirTeam and myTeam == theirTeam
        end
    end)
    
    -- Fallback: kiểm tra team color/name
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team == player.Team
    end
    
    return false
end

--- World to Screen Point
---@param pos Vector3
---@return Vector2|nil, boolean
local function WorldToScreen(pos)
    if not IsValid(Camera) then return nil, false end
    local success, result, onScreen = pcall(function()
        return Camera:WorldToViewportPoint(pos)
    end)
    if success then        return Vector2.new(result.X, result.Y), onScreen
    end
    return nil, false
end

--- Lấy tất cả players (loại trừ self)
---@return table
local function GetAllPlayers()
    local plist = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsValid(player) then
            table.insert(plist, player)
        end
    end
    return plist
end

--- Lấy kẻ địch gần nhất
---@param maxDist number
---@return Player|nil, number
local function GetNearestEnemy(maxDist)
    maxDist = maxDist or math.huge
    local nearest = nil
    local minDist = maxDist
    local myPos = GetPosition(LocalPlayer)
    
    if not myPos then return nil, math.huge end
    
    for _, player in pairs(GetAllPlayers()) do
        if IsAlive(player) and not IsTeammate(player) then
            local pos = GetPosition(player)
            if pos then
                local dist = Distance(myPos, pos)
                if dist < minDist then
                    minDist = dist
                    nearest = player
                end
            end
        end
    end
    
    return nearest, minDist
end

--- Lấy kẻ địch gần nhất đến crosshair (cho silent aim)
---@param fov number: Field of view max
---@return Player|nil, Vector3
local function GetNearestToCrosshair(fov)
    fov = fov or 180
    local closest = nil
    local shortestFov = fov
    local bestHitPos = nil
    
    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in pairs(GetAllPlayers()) do
        if IsAlive(player) and not IsTeammate(player) then
            local char = GetCharacter(player)
            local root = GetRootPart(char)
            
            if root then
                -- Kiểm tra nhiều hitbox points
                local hitpoints = {
                    root.Position + Vector3.new(0, 0, 0),   -- Body
                    root.Position + Vector3.new(0, 3, 0),   -- Head
                }
                
                -- Thêm head nếu có
                local head = char:FindFirstChild("Head")
                if head then
                    table.insert(hitpoints, head.Position)
                end
                
                for _, hitPos in pairs(hitpoints) do
                    local screenPos, onScreen = WorldToScreen(hitPos)
                    if onScreen and screenPos then
                        local diff = Vector2.new(screenPos.X - mousePos.X, screenPos.Y - mousePos.Y)
                        local currentFov = math.sqrt(diff.X * diff.X + diff.Y * diff.Y)
                        
                        if currentFov < shortestFov then
                            shortestFov = currentFov
                            closest = player
                            bestHitPos = hitPos
                        end
                    end
                end
            end
        end
    end
    
    return closest, bestHitPos
end

--- Raycast từ camera đến position (dùng để check wall bang)
---@param pos Vector3
---@return boolean: true nếu có line of sight
local function HasLineOfSight(pos)
    if not IsValid(Camera) then return false end
    
    local origin = Camera.CFrame.Position
    local direction = (pos - origin)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {GetCharacter(LocalPlayer)}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    
    local result = workspace:Raycast(origin, direction.Unit * direction.Magnitude, params)
    return result == nil
end

--- Tìm remote bằng name pattern
---@param pattern string
---@return RemoteEvent|RemoteFunction|nil
local function FindRemote(pattern)
    if not RemoteFolder then
        -- Tìm recursive trong ReplicatedStorage
        for _, desc in pairs(ReplicatedStorage:GetDescendants()) do
            if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") then
                if desc.Name:find(pattern) then
                    return desc
                end
            end
        end
        return nil
    end
    
    for _, item in pairs(RemoteFolder:GetChildren()) do
        if item:IsA("RemoteEvent") or item:IsA("RemoteFunction") then
            if item.Name:find(pattern) then
                return item
            end
        end
    end
    return nil
end

--- Fire remote an toàn với error handling
---@param remote RemoteEvent|RemoteFunction
---@param ... any: Arguments
local function SafeFire(remote, ...)
    if not IsValid(remote) then return false end
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(...)
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(...)
        end
    end)
    return true
end

