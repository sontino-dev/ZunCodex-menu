-- FLIGHT IMPLEMENTATION
local FlightConnection = nil
local FlyBodyVelocity = nil
local FlyBodyGyro = nil

function StartFlight()
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(myChar)
    if not myRoot then return end
    
    -- Create velocity bodymover
    FlyBodyVelocity = Instance.new("BodyVelocity")
    FlyBodyVelocity.Name = "ScriptFlyVel"
    FlyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    FlyBodyVelocity.Parent = myRoot
    
    -- Create gyro for control
    FlyBodyGyro = Instance.new("BodyGyro")
    FlyBodyGyro.Name = "ScriptFlyGyro"
    FlyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    FlyBodyGyro.P = 9e4
    FlyBodyGyro.Parent = myRoot
    
    FlightConnection = RunService.RenderStepped:Connect(function()
        if not Features.Flight.Enabled then return end
        
        local myChar = GetCharacter(LocalPlayer)
        local myRoot = GetRootPart(myChar)
        if not myRoot then return end
        
        if Features.Flight.Noclip then
            -- Make character clip through everything
            for _, part in pairs(myChar:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
        
        -- Calculate fly direction based on input
        local camCF = Camera.CFrame
        local moveVec = Vector3.new(0, 0, 0)
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveVec = moveVec + camCF.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveVec = moveVec - camCF.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveVec = moveVec - camCF.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveVec = moveVec + camCF.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveVec = moveVec + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            moveVec = moveVec - Vector3.new(0, 1, 0)
        end
        
        -- Apply movement
        if moveVec.Magnitude > 0 then
            moveVec = moveVec.Unit * Features.Flight.Speed
            
            if Features.Flight.Method == "velocity" and FlyBodyVelocity then
                FlyBodyVelocity.Velocity = moveVec
            elseif Features.Flight.Method == "cframe" then
                myRoot.CFrame = myRoot.CFrame + (moveVec * RunService.Heartbeat:Wait())
            end
        else
            if FlyBodyVelocity then
                FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
        end
        
        if FlyBodyGyro then
            FlyBodyGyro.CFrame = camCF
        end
    end)
end

function StopFlight()
    if FlightConnection then
        FlightConnection:Disconnect()
        FlightConnection = nil
    end
    
    if FlyBodyVelocity then
        FlyBodyVelocity:Destroy()
        FlyBodyVelocity = nil
    end
    
    if FlyBodyGyro then
        FlyBodyGyro:Destroy()
        FlyBodyGyro = nil
    end
    
    -- Restore collision
    local myChar = GetCharacter(LocalPlayer)
    if myChar then
        for _, part in pairs(myChar:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

