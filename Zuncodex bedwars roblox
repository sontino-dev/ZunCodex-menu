local function GetSATarget()
    if not C.Combat.SA.E then return nil end
    local hc=math.random(1,100)
    if hc>C.Combat.SA.HC then return nil end
    return GCPFM(C.Combat.SA.FV,C.Combat.SA.TC)
end
local OriginalRaycast=nil
local function SetupSA()
    if not Executor.SupportsHooks then return end
    pcall(function()
        OriginalRaycast=SafeHookMeta(workspace,"__index",function(self,idx,...)
            if idx=="Raycast" and C.Combat.SA.E then
                local t=GetSATarget()
                if t then
                    local tc=GC(t);local tp=tc:FindFirstChild(C.Combat.SA.HP) or GR(tc)
                    if tp then
                        local dir=(tp.Position-Camera.CFrame.Position).Unit
                        return {Instance=tp,Position=tp.Position,Distance=(tp.Position-Camera.CFrame).Magnitude,Material=tp.Material,Normal=-dir}
                    end
                end
            end
            if OriginalRaycast then return OriginalRaycast(self,idx,...) end
        end)
    end)
end

