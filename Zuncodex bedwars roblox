-- FREE CAMERA MODULE
Modules.FreeCamera = {
    Start = function()
        if Connections.FreeCam then return end
        local originalCF = Camera.CFrame
        local freeCamCF = originalCF
        Connections.FreeCam = Services.RunService.RenderStepped:Connect(function()
            if not Config.FreeCam.Enabled then return end
            local speed = Config.FreeCam.Speed or 8
            local moveVec = Vector3.new(0,0,0)
            if Services.UserInput:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + freeCamCF.LookVector end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec - freeCamCF.LookVector end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec - freeCamCF.RightVector end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + freeCamCF.RightVector end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.Space) then moveVec = moveVec + Vector3.new(0,1,0) end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.LeftControl) then moveVec = moveVec - Vector3.new(0,1,0) end
            if moveVec.Magnitude > 0 then
                freeCamCF = freeCamCF + (moveVec.Unit * speed * Services.RunService.Heartbeat:Wait())
            end
            local mouseMove = Services.UserInput:GetMouseDelta()
            local sensitivity = 0.5
            local angles = {X = 0, Y = 0}
            angles.Y = angles.Y - mouseMove.X * sensitivity
            angles.X = angles.X - mouseMove.Y * sensitivity
            freeCamCF = freeCamCF * CFrame.Angles(math.rad(angles.X), math.rad(angles.Y), 0)
            Camera.CFrame = freeCamCF
        end)
    end,
    Stop = function()
        if Connections.FreeCam then
            Connections.FreeCam:Disconnect()
            Connections.FreeCam = nil
        end
    end
}

-- CONFIG MODULE
Modules.Config = {
    Save = function()
        local configData = {Version = "4.0", SavedAt = os.time(), Features = {}}
        for featName, featData in pairs(Config) do
            if type(featData) == "table" and featData.Enabled ~= nil then
                configData.Features[featName] = {
                    Enabled = featData.Enabled,
                    Range = featData.Range,
                    Multiplier = featData.Multiplier,
                    Speed = featData.Speed,
                    FOV = featData.FOV,
                    HitChance = featData.HitChance,
                    CPS = featData.CPS
                }
            end
        end
        pcall(function()
            WriteFile("BedWarsVIP_config.json", Services.HttpService:JSONEncode(configData))
        end)
    end,
    Load = function()
        pcall(function()
            if IsFile("BedWarsVIP_config.json") then
                local configData = Services.HttpService:JSONDecode(ReadFile("BedWarsVIP_config.json"))
                if configData.Features then
                    for featName, featConfig in pairs(configData.Features) do
                        if Config[featName] then
                            for key, value in pairs(featConfig) do
                                Config[featName][key] = value
                            end
                        end
                    end
                end
            end
        end)
    end,
    Reset = function()
        for featName, featData in pairs(Config) do
            if type(featData) == "table" and featData.Enabled ~= nil then
                featData.Enabled = false
            end
        end
        -- Stop all modules
        for _, module in pairs(Modules) do
            if module.Stop then pcall(module.Stop) end
        end
    end,
    Panic = function()
        Modules.Config.Reset()
        if GUI.StatusText then
            GUI.StatusText.Text = "PANIC"
            GUI.StatusText.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
        if GUI.StatusDot then
            GUI.StatusDot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        end
    end
}

-- ============================================
-- KEYBIND HANDLER
-- ============================================

local function SetupKeybinds()
    Services.UserInput.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == GUI.ToggleKey then GUI:Toggle()
        elseif input.KeyCode == Config.Fly.Keybind then
            Config.Fly.Enabled = not Config.Fly.Enabled
            if Config.Fly.Enabled then Modules.Fly.Start() else Modules.Fly.Stop() end
        elseif input.KeyCode == Config.FreeCam.Keybind then
            Config.FreeCam.Enabled = not Config.FreeCam.Enabled
            if Config.FreeCam.Enabled then Modules.FreeCamera.Start() else Modules.FreeCamera.Stop() end
        elseif input.KeyCode == Enum.KeyCode.Delete then Modules.Config.Panic() end
    end)
    
    Player.CharacterAdded:Connect(function(char)
        local hum = Functions.GetHumanoid(char)
        if hum then
            if Config.HighJump.Enabled then
                hum.UseJumpPower = true
                hum.JumpPower = Config.HighJump.Power
            end
        end
    end)
end

