-- KILL AURA IMPLEMENTATION
local KillAuraConnection = nil

function StartKillAura()
    if KillAuraConnection then return end
    
    KillAuraConnection = RunService.RenderStepped:Connect(function()
        if not Features.KillAura.Enabled then return end
        
        local myChar = GetCharacter(LocalPlayer)
        local myRoot = GetRootPart(myChar)
        if not myRoot then return end
        
        local myPos = myRoot.Position
        
        -- Find enemies in range
        for _, player in pairs(GetAllPlayers()) do
            if IsAlive(player) and not IsTeammate(player) then
                local enemyPos = GetPosition(player)
                if enemyPos then
                    local dist = Distance(myPos, enemyPos)
                    
                    if dist <= Features.KillAura.Range then
                        -- Check wall
                        if Features.KillAura.ThroughWalls or HasLineOfSight(enemyPos) then
                            -- Attack using different modes
                            if Features.KillAura.Mode == "reach" then
                                -- Extend reach by manipulating tool range
                                pcall(function()
                                    local tool = myChar:FindFirstChildOfClass("Tool")
                                    if tool then
                                        local origRange = tool.Range or 3
                                        tool.Range = Features.KillAura.Range
                                    end
                                end)
                            elseif Features.KillAura.Mode == "silent" then
                                -- Fire damage remote directly
                                local damageRemote = FindRemote("damage") or FindRemote("attack") or FindRemote("hit")
                                if damageRemote then
                                    SafeFire(damageRemote, player, {
                                        Position = enemyPos,
                                        Damage = Features.OneShotKill.Enabled and Features.OneShotKill.Damage or 10
                                    })
                                end
                            else
                                -- Normal mode: simulate click/tap
                                VirtualInputManager:SendMouseWheelEvent(0, 0, true)
                                task.wait(0.05)
                                VirtualInputManager:SendMouseWheelEvent(0, 0, false)
                            end
                            
                            CurrentTarget = player
                        end
                    end
                end
            end
        end
    end)
end

function StopKillAura()
    if KillAuraConnection then
        KillAuraConnection:Disconnect()
        KillAuraConnection = nil
    end
    CurrentTarget = nil
end

-- SILENT AIM IMPLEMENTATION
local SilentAimHook = nil
local FOVDrawing = nil

function StartSilentAim()
    -- Create FOV circle drawing
    if Features.SilentAim.ShowFOV or Features.FOVCircle.Enabled then
        FOVDrawing = Drawing.new("Circle")
        FOVDrawing.Radius = Features.SilentAim.FOV
        FOVDrawing.Color = Features.FOVCircle.Color or Color3.fromRGB(255, 255, 255)
        FOVDrawing.Thickness = 1
        FOVDrawing.Transparency = Features.FOVCircle.Transparency or 0.5
        FOVDrawing.Visible = true
        FOVDrawing.NumPoints = 64
        FOVDrawing.Filled = Features.FOVCircle.Filled or false
    end
    
    -- Hook raycast/aim methods
    pcall(function()
        local oldRaycast = workspace.Raycast
        Hooks.OldRaycast = oldRaycast
        
        SilentAimHook = hookmeta(workspace, "__index", function(self, index, ...)
            if index == "Raycast" and Features.SilentAim.Enabled then
                local target, hitPos = GetNearestToCrosshair(Features.SilentAim.FOV)
                
                if target and (math.random(1, 100) <= Features.SilentAim.HitChance) then
                    -- Return modified raycast result pointing to target
                    local origin = Camera.CFrame.Position
                    local direction = (hitPos - origin).Unit
                    
                    return {
                        Position = hitPos,
                        Instance = GetCharacter(target):FindFirstChild(Features.SilentAim.TargetPart) or GetRootPart(GetCharacter(target)),
                        Material = Enum.Material.Plastic,
                        Normal = -direction
                    }
                end
            end
            
            return oldRaycast(self, index, ...)
        end)
    end)
    
    -- Update FOV circle position
    table.insert(Connections, RunService.RenderStepped:Connect(function()
        if FOVDrawing and (Features.SilentAim.ShowFOV or Features.FOVCircle.Enabled) then
            FOVDrawing.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            FOVDrawing.Radius = Features.SilentAim.FOV
            FOVDrawing.Visible = Features.SilentAim.Enabled or Features.FOVCircle.Enabled
        end
    end))
end

function StopSilentAim()
    -- Restore original raycast
    if SilentAimHook and Hooks.OldRaycast then
        pcall(function()
            hookmeta(workspace, "__index", Hooks.OldRaycast)
        end)
        SilentAimHook = nil
    end
    
    -- Remove FOV drawing
    if FOVDrawing then
        FOVDrawing:Remove()
        FOVDrawing = nil
    end
end

-- ESP IMPLEMENTATION (Drawing API - CLIENT SIDE ONLY)
local ESPDrawings = {}

function StartESP()
    -- Clear existing drawings first
    StopESP()
    
    table.insert(Connections, RunService.RenderStepped:Connect(function()
        if not Features.ESP.Enabled then return end
        
        for _, player in pairs(GetAllPlayers()) do
            if IsAlive(player) then
                local char = GetCharacter(player)
                local root = GetRootPart(char)
                
                if root then
                    local screenPos, onScreen = WorldToScreen(root.Position)
                    
                    if onScreen and screenPos then
                        local dist = Distance(GetPosition(LocalPlayer), root.Position)
                        
                        if dist <= Features.ESP.MaxDistance then
                            local isEnemy = not IsTeammate(player)
                            local color = isEnemy and Features.ESP.EnemyColor or Features.ESP.TeamColor
                            
                            -- Create/get drawings for this player
                            if not ESPDrawings[player.UserId] then
                                ESPDrawings[player.UserId] = {
                                    Box = Drawing.new("Square"),
                                    Name = Drawing.new("Text"),
                                    Health = Drawing.new("Text"),
                                    Dist = Drawing.new("Text"),
                                    Tracer = Drawing.new("Line")
                                }
                                
                                -- Configure box
                                local box = ESPDrawings[player.UserId].Box
                                box.Thickness = 1
                                box.Filled = false
                                box.Color = color
                                
                                -- Configure name
                                local name = ESPDrawings[player.UserId].Name
                                name.Size = Features.ESP.TextSize
                                name.Center = true
                                name.Outline = true
                                name.Color = color
                                
                                -- Configure health
                                local health = ESPDrawings[player.UserId].Health
                                health.Size = Features.ESP.TextSize - 2
                                health.Center = true
                                health.Outline = true
                                health.Color = Color3.fromRGB(50, 255, 50)
                                
                                -- Configure distance
                                local distTxt = ESPDrawings[player.UserId].Dist
                                distTxt.Size = Features.ESP.TextSize - 2
                                distTxt.Center = true
                                distTxt.Outline = true
                                distTxt.Color = Color3.fromRGB(200, 200, 200)
                                
                                -- Configure tracer
                                local tracer = ESPDrawings[player.UserId].Tracer
                                tracer.Thickness = Features.Tracers.Thickness or 1
                                tracer.Color = Features.Tracers.Color or Color3.fromRGB(255, 255, 255)
                            end
                        
                            local drawings = ESPDrawings[player.UserId]
                            local human = GetHumanoid(char)
                            
                            -- Calculate box size based on distance
                            local scaleFactor = 1 / (dist * 0.001)
                            local boxHeight = 4 * scaleFactor
                            local boxWidth = 3 * scaleFactor
                            
                            -- Update box
                            if Features.ESP.Box then
                                drawings.Box.Position = Vector2.new(screenPos.X - boxWidth/2, screenPos.Y - boxHeight/2)
                                drawings.Box.Size = Vector2.new(boxWidth, boxHeight)
                                drawings.Box.Color = color
                                drawings.Box.Visible = true
                            else
                                drawings.Box.Visible = false
                            end
                            
                            -- Update name
                            if Features.ESP.Name then
                                drawings.Name.Position = Vector2.new(screenPos.X, screenPos.Y - boxHeight/2 - 15)
                                drawings.Name.Text = player.Name
                                drawings.Name.Color = color
                                drawings.Name.Visible = true
                            else
                                drawings.Name.Visible = false
                            end
                            
                            -- Update health
                            if Features.ESP.Health and human then
                                drawings.Health.Position = Vector2.new(screenPos.X, screenPos.Y + boxHeight/2 + 2)
                                drawings.Health.Text = "HP: " .. math.floor(human.Health)
                                drawings.Health.Visible = true
                            else
                                drawings.Health.Visible = false
                            end
                            
                            -- Update distance
                            if Features.ESP.Distance then
                                drawings.Dist.Position = Vector2.new(screenPos.X, screenPos.Y + boxHeight/2 + 16)
                                drawings.Dist.Text = "[" .. math.floor(dist) .. "m]"
                                drawings.Dist.Visible = true
                            else
                                drawings.Dist.Visible = false
                            end
                            
                            -- Update tracer
                            if Features.Tracers.Enabled then
                                local fromY = Camera.ViewSize.Y
                                if Features.Tracers.From == "center" then
                                    fromY = Camera.ViewSize.Y / 2
                                elseif Features.Tracers.From == "top" then
                                    fromY = 0
                                end
                                
                                drawings.Tracer.From = Vector2.new(Camera.ViewSize.X / 2, fromY)
                                drawings.Tracer.To = screenPos
                                drawings.Tracer.Visible = true
                            else
                                drawings.Tracer.Visible = false
                            end
                        else
                            -- Too far, hide
                            self:HidePlayerESP(player.UserId)
                        end
                    else
                        -- Off screen, hide
                        self:HidePlayerESP(player.UserId)
                    end
                else
                    self:HidePlayerESP(player.UserId)
                end
            else
                self:HidePlayerESP(player.UserId)
            end
        end
    end))
end

function StopESP()
    -- Remove all ESP drawings
    for userId, drawings in pairs(ESPDrawings) do
        for _, drawing in pairs(drawings) do
            if typeof(drawing) == "table" and drawing.Remove then
                drawing:Remove()
            end
        end
    end
    ESPDrawings = {}
end

function GUI:HidePlayerESP(userId)
    if ESPDrawings[userId] then
        for _, drawing in pairs(ESPDrawings[userId]) do
            drawing.Visible = false
        end
    end
end

-- AUTO SCAFFOLD IMPLEMENTATION
local ScaffoldConnection = nil

function StartAutoScaffold()
    ScaffoldConnection = RunService.RenderStepped:Connect(function()
        if not Features.AutoScaffold.Enabled then return end
        
        local myChar = GetCharacter(LocalPlayer)
        local myRoot = GetRootPart(myChar)
        if not myRoot then return end
        
        local pos = myRoot.Position
        local belowPos = Vector3.new(pos.X, pos.Y - 3, pos.Z)
        
        -- Check if there's no block below
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {myChar}
        params.FilterType = Enum.RaycastFilterType.Blacklist
        
        local result = workspace:Raycast(pos, Vector3.new(0, -5, 0), params)
        
        if not result or (result.Position - pos).Magnitude > 4 then
            -- Place block below
            local placeRemote = FindRemote("placeBlock") or FindRemote("build") or FindRemote("block")
            if placeRemote then
                SafeFire(placeRemote, belowPos)
            end
            
            -- Tower mode: stack blocks upward when looking down
            if Features.AutoScaffold.TowerMode then
                local lookDir = Camera.CFrame.LookVector
                if lookDir.Y < -0.7 then -- Looking mostly downward
                    local towerPos = Vector3.new(pos.X, pos.Y + 2, pos.Z)
                    SafeFire(placeRemote, towerPos)
                end
            end
            
            -- Expand mode: place blocks around
            if Features.AutoScaffold.ExpandMode then
                local offsets = {
                    Vector3.new(3, 0, 0),
                    Vector3.new(-3, 0, 0),
                    Vector3.new(0, 0, 3),
                    Vector3.new(0, 0, -3)
                }
                
                for _, offset in pairs(offsets) do
                    local expandPos = pos + offset
                    SafeFire(placeRemote, expandPos)
                end
            end
        end
    end)
end

function StopAutoScaffold()
    if ScaffoldConnection then
        ScaffoldConnection:Disconnect()
        ScaffoldConnection = nil
    end
end

