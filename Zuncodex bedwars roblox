-- ====== BED NUKER =====_
local LBN=0
local function BedNuker()
    if not C.UT.BN.E then return end
    local ct=tick()
    if ct-LBN>=C.UT.BN.D then
        local c=GC(LocalPlayer);local r=GR(c)
        if r then
            for _,obj in pairs(Workspace:GetDescendants()) do
                local n=obj.Name:lower()
                if n:find("bed") and (obj:IsA("BasePart") or obj:IsA("Model")) then
                    local pos=obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                    if pos then
                        local d=GD(r.Position,pos)
                        if d<=C.UT.BN.R then
                            FR("BedBreak",obj);FR("BreakBed",obj)
                            LBN=ct;break
                        end
                    end
                end
            end
        end
    end
end

