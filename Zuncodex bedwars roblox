    local svr=Instance.new("UICorner");svr.CornerRadius=UDim.new(0,4);svr.Parent=sv
    sv.MouseButton1Click:Connect(function()
        local j=EncodeJSON(C)
        if SafeWriteFile("DeltaBedwars_V4.cfg",j) then
            print("[DBW] Config saved!")
        else
            warn("[DBW] Cannot save config - File IO not supported")
        end
    end)
    
