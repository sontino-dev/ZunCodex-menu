    valueLabel.Size = UDim2.new(0.35, 0, 1, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(defaultValue)
    valueLabel.TextColor3 = Color3.fromRGB(100, 180, 255)
    valueLabel.TextSize = 12
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = topRow
    
    -- Track
    local track = Instance.new("Frame")
    track.Name = "Track"
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 1, -6)
    track.BackgroundColor3 = Color3.fromRGB(42, 42, 58)
    track.BorderSizePixel = 0
    track.Parent = container
    
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(0, 3)
    trackCorner.Parent = track
    
    -- Fill
    local fillPercent = (defaultValue - minValue) / (maxValue - minValue)
    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new(fillPercent, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(80, 130, 255)
    fill.BorderSizePixel = 0
    fill.Parent = track
    
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 3)
    fillCorner.Parent = fill
    
    -- Thumb
    local thumb = Instance.new("Frame")
    thumb.Name = "Thumb"
    thumb.Size = UDim2.new(0, 16, 0, 16)
    thumb.Position = UDim2.new(fillPercent, -8, 0.5, -8)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.Parent = track
    
    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(0, 8)
    thumbCorner.Parent = thumb
    
    -- Drag Logic
    local dragging = false
    local dragConnection
    
    local function updateSlider(input)
        local relativeX = Functions.Clamp(
            (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 
            0, 
            1
        )
        local value = minValue + (maxValue - minValue) * relativeX
        
        fillPercent = relativeX
        fill.Size = UDim2.new(fillPercent, 0, 1, 0)
        thumb.Position = UDim2.new(fillPercent, -8, 0.5, -8)
        valueLabel.Text = tostring(Functions.Round(value, 1))
        
        if callback then
            callback(value)
        end
    end
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
            
            dragConnection = Services.RunService.RenderStepped:Connect(function()
                if dragging and Services.UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    updateSlider(Services.UserInput:GetMouseLocation())
                end
            end)
        end
    end)
    
    track.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            if dragConnection then
                dragConnection:Disconnect()
                dragConnection = nil
            end
        end
    end)
    
    return yPos + 50
end

