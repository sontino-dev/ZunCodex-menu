-- JSON encode/decode (built-in for safety)
local JSONEncode = nil
local JSONDecode = nil

if game:GetService("HttpService") then
    local HttpService = game:GetService("HttpService")
    JSONEncode = function(t) return HttpService:JSONEncode(t) end
    JSONDecode = function(s) return HttpService:JSONDecode(s) end
else
    -- Fallback simple JSON
    JSONEncode = function(t)
        if type(t) == "table" then
            local s = "{"
            for k,v in pairs(t) do
                if type(k) == "string" then
                    s = s .. '"' .. k .. '":'
                else
                    s = s .. tostring(k) .. ":"
                end
                if type(v) == "string" then
                    s = s .. '"' .. v .. '",'
                elseif type(v) == "table" then
                    s = s .. JSONEncode(v) .. ","
                else
                    s = s .. tostring(v) .. ","
                end
            end
            s = s .. "}"
            return s
        else
            return tostring(t)
        end
    end
    JSONDecode = function(s)
        -- Very basic decode - may not work for complex objects
        local f = load("return " .. s)
        if f then
            local success, result = pcall(f)
            if success then return result end
        end
        return {}
    end
end

