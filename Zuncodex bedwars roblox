    bnc.CornerRadius = UDim.new(0,9)
    bnc.Parent = btn
    
    local ind = Instance.new("Frame")
    ind.Size = UDim2.new(0,14,0,14)
    ind.Position = UDim2.new(0,2,0.5,-7)
    ind.BackgroundColor3 = Color3.fromRGB(255,255,255)
    ind.BorderSizePixel = 0
    ind.Parent = btn
    
    local ic = Instance.new("UICorner")
    ic.CornerRadius = UDim.new(0,7)
    ic.Parent = ind
    
    local keys = strsplit(path, ".")
    local function getVal()
        local v = Cfg
        for _,k in pairs(keys) do
            if v[k] then v = v[k] else return false end
        end
        return v
    end
    local function setVal(val)
        local t = Cfg
        for i=1,#keys-1 do
            if t[keys[i]] then t = t[keys[i]] else return end
        end
        t[keys[#keys]] = val
    end
    
    local state = getVal()
    local function update()
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(138,43,226)
            ind.Position = UDim2.new(0,18,0.5,-7)
        else
            btn.BackgroundColor3 = Color3.fromRGB(80,80,80)
            ind.Position = UDim2.new(0,2,0.5,-7)
        end
    end
    update()
    
    btn.MouseButton1Click:Connect(function()
        state = not state
        setVal(state)
        update()
        if cb then cb(state) end
    end)
    
    return f
end

