-- ESP MODULE
Modules.ESP = {
    Start = function()
        self:Stop()
        
        ConnectionHandlers.ESP = Services.RunService.RenderStepped:Connect(function()
            if not Config.ESP.Enabled then return end
            
            for _, pl in pairs(Functions.GetAllPlayers()) do
                if not Functions.IsAlive(pl) then
                    self:HidePlayerESP(pl.UserId)
                    continue
                end
                
                local char = Functions.GetCharacter(pl)
                local root = Functions.GetRootPart(char)
                if not root then
                    self:HidePlayerESP(pl.UserId)
                    continue
                end
                
                local screenPos, onScreen = Functions.WorldToScreen(root.Position)
                if not onScreen or not screenPos then
                    self:HidePlayerESP(pl.UserId)
                    continue
                end
                
                local myPos = Functions.GetPosition(Player)
                local dist = Functions.Distance(myPos, root.Position)
                
                if dist > Config.ESP.MaxDistance then
                    self:HidePlayerESP(pl.UserId)
                    continue
                end
                
                local isEnemy = not Functions.IsTeammate(pl)
                local color = isEnemy and Config.ESP.EnemyColor or Config.ESP.TeamColor
                
                -- Create ESP objects if needed
                if not ESPData[pl.UserId] then
                    ESPData[pl.UserId] = {
                        Box = Drawing.new("Square"),
                        Name = Drawing.new("Text"),
                        Health = Drawing.new("Text"),
                        Distance = Drawing.new("Text"),
                        Tool = Drawing.new("Text"),
                        Tracer = Drawing.new("Line")
                    }
                    
                    -- Configure drawings
                    local data = ESPData[pl.UserId]
                    data.Box.Thickness = 1
                    data.Box.Filled = false
                    data.Box.Color = color
                    
                    data.Name.Size = Config.ESP.TextSize
                    data.Name.Center = true
                    data.Name.Outline = true
                    data.Name.Color = color
                    
                    data.Health.Size = Config.ESP.TextSize - 2
                    data.Health.Center = true
                    data.Health.Outline = true
                    data.Health.Color = Color3.fromRGB(50, 255, 50)
                    
                    data.Distance.Size = Config.ESP.TextSize - 2
                    data.Distance.Center = true
                    data.Distance.Outline = true
                    data.Distance.Color = Color3.fromRGB(200, 200, 200)
                    
                    data.Tool.Size = Config.ESP.TextSize - 2
                    data.Tool.Center = true
                    data.Tool.Outline = true
                    data.Tool.Color = Color3.fromRGB(255, 220, 100)
                    
                    data.Tracer.Thickness = Config.Tracers.Thickness or 1.2
                    data.Tracer.Color = Config.Tracers.Color or Color3.fromRGB(255, 255, 255)
                end
                
                local data = ESPData[pl.UserId]
                local hum = Functions.GetHumanoid(char)
                
                -- Calculate box dimensions
                local scaleFactor = 1 / (dist * 0.001)
                local boxHeight = 4.5 * scaleFactor
                local boxWidth = 3.5 * scaleFactor
                
                -- Update Box ESP
                if Config.ESP.BoxESP then
                    data.Box.Position = Vector2.new(screenPos.X - boxWidth/2, screenPos.Y - boxHeight/2)
                    data.Box.Size = Vector2.new(boxWidth, boxHeight)
                    data.Box.Color = color
                    data.Box.Visible = true
                else
                    data.Box.Visible = false
                end
                
                -- Update Name
                if Config.ESP.ShowNames then
                    data.Name.Position = Vector2.new(screenPos.X, screenPos.Y - boxHeight/2 - 16)
                    data.Name.Text = pl.Name
                    data.Name.Color = color
                    data.Name.Visible = true
                else
                    data.Name.Visible = false
                end
                
                -- Update Health
                if Config.ESP.ShowHealth and hum then
                    data.Health.Position = Vector2.new(screenPos.X, screenPos.Y + boxHeight/2 + 2)
                    data.Health.Text = "HP: " .. math.floor(hum.Health)
                    data.Health.Visible = true
                else
                    data.Health.Visible = false
                end
                
                -- Update Distance
                if Config.ESP.ShowDistance then
                    data.Distance.Position = Vector2.new(screenPos.X, screenPos.Y + boxHeight/2 + 16)
                    data.Distance.Text = "[" .. math.floor(dist) .. "m]"
                    data.Distance.Visible = true
                else
                    data.Distance.Visible = false
                end
                
                -- Update Tool
                if Config.ESP.ShowTool then
                    local tool = char:FindFirstChildOfClass("Tool")
                    data.Tool.Position = Vector2.new(screenPos.X, screenPos.Y + boxHeight/2 + 30)
                    data.Tool.Text = tool and tool.Name or "None"
                    data.Tool.Visible = true
                else
                    data.Tool.Visible = false
                end
                
                -- Update Tracer
                if Config.ESP.Tracers then
                    local fromY = Camera.ViewSize.Y
                    if Config.Tracers.FromPosition == "Center" then
                        fromY = Camera.ViewSize.Y / 2
                    elseif Config.Tracers.FromPosition == "Top" then
                        fromY = 0
                    elseif Config.Tracers.FromPosition == "Mouse" then
                        fromY = Services.UserInput:GetMouseLocation().Y
                    end
                    
                    data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, fromY)
                    data.Tracer.To = screenPos
                    data.Tracer.Visible = true
                else
                    data.Tracer.Visible = false
                end
            end
        end)
    end,
    
    Stop = function()
        if ConnectionHandlers.ESP then
            ConnectionHandlers.ESP:Disconnect()
            ConnectionHandlers.ESP = nil
        end
        self:ClearAllESP()
    end,
    
    HidePlayerESP = function(uid)
        if ESPData[uid] then
            for _, drawing in pairs(ESPData[uid]) do
                drawing.Visible = false
            end
        end
    end,
    
    ClearAllESP = function()
        for uid, data in pairs(ESPData) do
            for _, drawing in pairs(data) do
                if typeof(drawing) == "table" and drawing.Remove then
                    drawing:Remove()
                end
            end
        end
        ESPData = {}
    end
}

