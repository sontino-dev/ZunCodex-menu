-- Safe Hook wrappers
local SafeHookFunction = function(...)
    if Executor.SupportsHooks and hookfunction then
        local ok, r = pcall(hookfunction, ...)
        if ok then return r end
    end
    return select(1, ...)
end

local SafeHookMeta = function(...)
    if Executor.SupportsHooks and hookmetamethod then
        local ok, r = pcall(hookmetamethod, ...)
        if ok then return r end
    end
    return select(2, ...)
end

