-- SPEED HACK MODULE
Modules.SpeedHack = {
    Start = function()
        if Connections.SpeedHack then return end
        Connections.SpeedHack = Services.RunService.Heartbeat:Connect(function()
            if not Config.SpeedHack.Enabled then return end
            local hum = Functions.GetHumanoid(Functions.GetCharacter(Player))
            if hum then
                if Config.SpeedHack.Method == "Velocity" then
                    if not BodyMovers.Velocity then
                        local root = Functions.GetRootPart(Functions.GetCharacter(Player))
                        if root then
                            BodyMovers.Velocity = Instance.new("BodyVelocity")
                            BodyMovers.Velocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            BodyMovers.Velocity.Parent = root
                        end
                    end
                    if BodyMovers.Velocity then
                        BodyMovers.Velocity.Velocity = Vector3.new(
                            hum.MoveDirection.X * 16 * Config.SpeedHack.Multiplier,
                            0,
                            hum.MoveDirection.Z * 16 * Config.SpeedHack.Multiplier
                        )
                    end
                else
                    hum.WalkSpeed = 16 * Config.SpeedHack.Multiplier
                end
            end
        end)
    end,
    Stop = function()
        if Connections.SpeedHack then
            Connections.SpeedHack:Disconnect()
            Connections.SpeedHack = nil
        end
        if BodyMovers.Velocity then
            BodyMovers.Velocity:Destroy()
            BodyMovers.Velocity = nil
        end
        local hum = Functions.GetHumanoid(Functions.GetCharacter(Player))
        if hum then hum.WalkSpeed = 16 end
    end
}

-- FLY MODULE
Modules.Fly = {
    Start = function()
        if Connections.Fly then return end
        local myChar = Functions.GetCharacter(Player)
        local myRoot = Functions.GetRootPart(myChar)
        if not myRoot then return end
        
        BodyMovers.Velocity = Instance.new("BodyVelocity")
        BodyMovers.Velocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        BodyMovers.Velocity.Velocity = Vector3.new(0,0,0)
        BodyMovers.Velocity.Parent = myRoot
        
        BodyMovers.Gyro = Instance.new("BodyGyro")
        BodyMovers.Gyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        BodyMovers.Gyro.P = 9e4
        BodyMovers.Gyro.Parent = myRoot
        
        Connections.Fly = Services.RunService.RenderStepped:Connect(function()
            if not Config.Fly.Enabled then return end
            local myChar = Functions.GetCharacter(Player)
            local myRoot = Functions.GetRootPart(myChar)
            if not myRoot then return end
            
            if Config.Fly.NoClip then
                for _, part in pairs(myChar:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
            
            local camCF = Camera.CFrame
            local moveVec = Vector3.new(0,0,0)
            if Services.UserInput:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + camCF.LookVector end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec - camCF.LookVector end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec - camCF.RightVector end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + camCF.RightVector end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.Space) then moveVec = moveVec + Vector3.new(0,1,0) end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.LeftControl) then moveVec = moveVec - Vector3.new(0,1,0) end
            
            if moveVec.Magnitude > 0 then
                moveVec = moveVec.Unit * Config.Fly.Speed
                if Config.Fly.Method == "Velocity" and BodyMovers.Velocity then
                    BodyMovers.Velocity.Velocity = moveVec
                elseif Config.Fly.Method == "CFrame" then
                    myRoot.CFrame = myRoot.CFrame + (moveVec * Services.RunService.Heartbeat:Wait())
                end
            else
                if BodyMovers.Velocity then BodyMovers.Velocity.Velocity = Vector3.new(0,0,0) end
            end
            if BodyMovers.Gyro then BodyMovers.Gyro.CFrame = camCF end
        end)
    end,
    Stop = function()
        if Connections.Fly then
            Connections.Fly:Disconnect()
            Connections.Fly = nil
        end
        if BodyMovers.Velocity then BodyMovers.Velocity:Destroy(); BodyMovers.Velocity = nil end
        if BodyMovers.Gyro then BodyMovers.Gyro:Destroy(); BodyMovers.Gyro = nil end
