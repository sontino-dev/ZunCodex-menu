-- CONFIG MODULE
Modules.Config = {
    Save = function()
        local configData = {
            Version = "4.0",
            SavedAt = os.time(),
            Features = {}
        }
        
        for featName, featData in pairs(Config) do
            if type(featData) == "table" and featData.Enabled ~= nil then
                configData.Features[featName] = {
                    Enabled = featData.Enabled,
                    Range = featData.Range,
                    Multiplier = featData.Multiplier,
                    Speed = featData.Speed,
                    FOV = featData.FOV,
                    HitChance = featData.HitChance,
                    CPS = featData.CPS
                }
            end
        end
        
        pcall(function()
            WriteFile("BedWarsVIP_config.json", Services.HttpService:JSONEncode(configData))
        end)
    end,
    
    Load = function()
        pcall(function()
            if IsFile("BedWarsVIP_config.json") then
                local configData = Services.HttpService:JSONDecode(
                    ReadFile("BedWarsVIP_config.json")
                )
                
                if configData.Features then
                    for featName, featConfig in pairs(configData.Features) do
                        if Config[featName] then
                            for key, value in pairs(featConfig) do
                                Config[featName][key] = value
                            end
                        end
                    end
                end
            end
        end)
    end,
    
    Reset = function()
        for featName, featData in pairs(Config) do
            if type(featData) == "table" and featData.Enabled ~= nil then
                featData.Enabled = false
            end
        end
        
        -- Stop all modules
        Modules.KillAura.Stop()
        Modules.SilentAim.Stop()
        Modules.Aimbot.Stop()
        Modules.TriggerBot.Stop()
        Modules.SpeedHack.Stop()
        Modules.Fly.Stop()
        Modules.NoClip.Stop()
        Modules.InfiniteJump.Stop()
        Modules.AntiVoid.Stop()
        Modules.NoFallDamage.Stop()
        Modules.Spider.Stop()
        Modules.ESP.Stop()
        Modules.BedESP.Stop()
        Modules.ItemESP.Stop()
        Modules.Tracers.Stop()
        Modules.Chams.Stop()
        Modules.FOVCircle.Stop()
        Modules.AutoBridge.Stop()
        Modules.AutoClick.Stop()
        Modules.BedNuker.Stop()
        Modules.AutoFarm.Stop()
        Modules.AutoScaffold.Stop()
        Modules.AutoHeal.Stop()
        Modules.AntiAim.Stop()
        Modules.GodMode.Stop()
        Modules.NoCooldown.Stop()
        Modules.ReachHack.Stop()
        Modules.OneShotKill.Stop()
        Modules.FreeCamera.Stop()
    end,
    
    Panic = function()
        self:Reset()
        
        if GUI.StatusText then
            GUI.StatusText.Text = "PANIC"
            GUI.StatusText.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
        
        if GUI.StatusDot then
            GUI.StatusDot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        end
    end
}

-- ============================================
-- KEYBIND HANDLER
-- ============================================

local function SetupKeybinds()
    -- GUI Toggle
    table.insert(Connections, Services.UserInput.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == GUI.ToggleKey then
            GUI:Toggle()
        elseif input.KeyCode == Config.Fly.Keybind then
            Config.Fly.Enabled = not Config.Fly.Enabled
            if Config.Fly.Enabled then
                Modules.Fly.Start()
            else
                Modules.Fly.Stop()
            end
        elseif input.KeyCode == Config.FreeCam.Keybind then
            Config.FreeCam.Enabled = not Config.FreeCam.Enabled
            if Config.FreeCam.Enabled then
                Modules.FreeCamera.Start()
            else
                Modules.FreeCamera.Stop()
            end
        elseif input.KeyCode == Enum.KeyCode.Delete then
            Modules.Config.Panic()
        end
    end))
    
    -- Character Added (for jump power)
    table.insert(Connections, Player.CharacterAdded:Connect(function(char)
        local hum = Functions.GetHumanoid(char)
        if hum then
            if Config.HighJump.Enabled then
                hum.UseJumpPower = true
                hum.JumpPower = Config.HighJump.Power
            end
        end
    end))
end

-- ============================================
-- INITIALIZATION
-- ============================================

local function Initialize()
    print("=" .. string.rep("=", 55))
    print("[BedWarsVIP] Initializing v4.0...")
    print("[BedWarsVIP] Detecting executor...")
    
    -- Log executor
    for name, detected in pairs(Executor) do
        if detected then
            print("[BedWarsVIP] ✓ " .. name)
        end
    end
    
    -- Create GUI
    GUI:Create()
    
    -- Setup keybinds
    SetupKeybinds()
    
    -- Load saved config
    Modules.Config.Load()
    
    -- Apply initial settings
    if Config.HighJump.Enabled then
        local myChar = Functions.GetCharacter(Player)
        local hum = Functions.GetHumanoid(myChar)
        if hum then
            hum.UseJumpPower = true
            hum.JumpPower = Config.HighJump.Power
        end
    end
    
    print("[BedWarsVIP] ✓ Initialization complete!")
    print("[BedWarsVIP] Press " .. tostring(GUI.ToggleKey.Name) .. " to toggle GUI")
    print("=" .. string.rep("=", 55))
end

-- Run initialization
Initialize()

-- Return public API
return {
    Config = Config,
    GUI = GUI,
    Modules = Modules,
    ToggleFeature = function(name, state)
        if Config[name] then
            Config[name].Enabled = state
            GUI:OnFeatureToggled(name, Config[name])
            return true
        end
        return false
    end,
    GetFeature = function(name)
        return Config[name]
    end,
    Panic = function()
        Modules.Config.Panic()
    end,
    Reload = Initialize
}
