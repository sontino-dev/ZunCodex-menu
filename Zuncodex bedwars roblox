local Flying=false;local BV=nil;local BG=nil;local FC=nil
local function StartFly()
    local c=GC(LocalPlayer);local r=GR(c)
    if not r then return end
    Flying=true
    BV=Instance.new("BodyVelocity");BV.Name="DBW_Fly";BV.Velocity=Vector3.new(0,0,0);BV.MaxForce=Vector3.new(math.huge,math.huge,math.huge);BV.Parent=r
    BG=Instance.new("BodyGyro");BG.Name="DBW_Gyro";BG.CFrame=r.CFrame;BG.MaxTorque=Vector3.new(math.huge,math.huge,math.huge);BG.P=9e4;BG.Parent=r
    FC=RunService.RenderStepped:Connect(function()
        if not Flying or not C.MOV.FL.E then StopFly();return end
        if r and BV and BG then
            local ld=Camera.CFrame.LookVector;local mv=Vector3.new(0,0,0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv=mv+Vector3.new(ld.X,0,ld.Z) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv=mv-Vector3.new(ld.X,0,ld.Z) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv=mv+Vector3.new(-ld.Z,0,ld.X) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv=mv-Vector3.new(-ld.Z,0,ld.X) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv=mv+Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv=mv-Vector3.new(0,1,0) end
            if mv.Magnitude>0 then mv=mv.Unit*C.MOV.FL.S end
            BV.Velocity=mv;BG.CFrame=Camera.CFrame
        end
    end)
end
local function StopFly()
    Flying=false
    if FC then pcall(function()FC:Disconnect()end);FC=nil end
    if BV then pcall(function()BV:Destroy()end);BV=nil end
    if BG then pcall(function()BG:Destroy()end);BG=nil end
end

