-- ====== KILL AURA ======
local LastKA=0
local function KillAura()
    if not C.Combat.KA.E then return end
    local ct=tick()
    if ct-LastKA>=C.Combat.KA.D then
        local target,_=GCP(C.Combat.KA.R,true,true)
        if target then
            local tc=GC(target);local th=GH(tc)
            if th and th.Health>0 then
                FR("AttackEvent",target)
                FR("HitEvent",target)
                FR("SwordHit",target)
                FR("DamageEvent",target)
                if C.Combat.KA.H then
                    pcall(function()
                        local vim=game:GetService("VirtualInputManager")
                        vim:SendMouseButtonEvent(0,0,0,true,game,0)
                        wait(0.05)
                        vim:SendMouseButtonEvent(0,0,0,false,game,0)
                    end)
                end
                LastKA=ct
            end
        end
    end
end

