-- SPLIT FUNCTION (Lua 5.1)
local function strsplit(str, sep)
    if not str then return {} end
    sep = sep or "%s"
    local t = {}
    for s in string.gmatch(str..sep, "(.-)"..sep) do
        table.insert(t, s)
    end
    return t
end
if not string.split then string.split = strsplit end

