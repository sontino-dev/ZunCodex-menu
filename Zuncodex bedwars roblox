-- INITIALIZATION
-- ============================================

local function Initialize()
    print("=" .. string.rep("=", 55))
    print("[BedWarsVIP] Initializing v4.0 (Delta Compatible)...")
    
    -- Create GUI
    GUI:Create()
    SetupKeybinds()
    Modules.Config.Load()
    
    -- Apply initial settings
    if Config.HighJump.Enabled then
        local myChar = Functions.GetCharacter(Player)
        local hum = Functions.GetHumanoid(myChar)
        if hum then hum.UseJumpPower = true; hum.JumpPower = Config.HighJump.Power end
    end
    
    print("[BedWarsVIP] ✓ Initialization complete!")
    print("[BedWarsVIP] Press " .. tostring(GUI.ToggleKey.Name) .. " to toggle GUI")
    print("=" .. string.rep("=", 55))
end

-- Run initialization
Initialize()

return {
    Config = Config,
    GUI = GUI,
    Modules = Modules,
    ToggleFeature = function(name, state)
        if Config[name] then
            Config[name].Enabled = state
            GUI:OnFeatureToggled(name, Config[name])
            return true
        end
        return false
    end,
    GetFeature = function(name) return Config[name] end,
    Panic = function() Modules.Config.Panic() end,
    Reload = Initialize
}
