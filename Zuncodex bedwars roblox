Modules = {}

-- KILL AURA MODULE
Modules.KillAura = {
    Start = function()
        if ConnectionHandlers.KillAura then return end
        
        ConnectionHandlers.KillAura = Services.RunService.RenderStepped:Connect(function()
            if not Config.KillAura.Enabled then return end
            
            local myChar = Functions.GetCharacter(Player)
            local myRoot = Functions.GetRootPart(myChar)
            if not myRoot then return end
            
            local myPos = myRoot.Position
            local targets = {}
            
            for _, enemy in pairs(Functions.GetAllPlayers()) do
                if Functions.IsAlive(enemy) and not Functions.IsTeammate(enemy) then
                    local enemyPos = Functions.GetPosition(enemy)
                    if enemyPos then
                        local dist = Functions.Distance(myPos, enemyPos)
                        if dist <= Config.KillAura.Range then
                            if Config.KillAura.ThroughWalls or Functions.HasLineOfSight(enemyPos) then
                                table.insert(targets, {Player = enemy, Position = enemyPos, Distance = dist})
                            end
                        end
                    end
                end
            end
            
            -- Sort by distance
            table.sort(targets, function(a, b) return a.Distance < b.Distance end)
            
            -- Attack targets
            for i = 1, math.min(#targets, Config.KillAura.MaxTargets) do
                local target = targets[i].Player
                
                if Config.KillAura.Mode == "Silent" then
                    local attackRemote = Functions.FindRemote("Attack") 
                        or Functions.FindRemote("Damage") 
                        or Functions.FindRemote("Hit")
                    
                    if attackRemote then
                        Functions.FireRemote(attackRemote, target, {
                            Position = targets[i].Position,
                            Damage = Config.OneShotKill.Enabled and Config.OneShotKill.Damage or 10
                        })
                    end
                elseif Config.KillAura.Mode == "Reach" then
                    pcall(function()
                        local tool = myChar:FindFirstChildOfClass("Tool")
                        if tool then
                            tool.Range = Config.KillAura.Range
                        end
                    end)
                else
                    -- Normal mode - simulate click
                    Services.VirtualInput:SendMouseButtonEvent(
                        0, 0, 0, true, 
                        Enum.UserInputType.MouseButton1, false
                    )
                    task.wait(Config.KillAura.Delay)
                    Services.VirtualInput:SendMouseButtonEvent(
                        0, 0, 0, false, 
                        Enum.UserInputType.MouseButton1, false
                    )
                end
                
                CurrentTarget = target
            end
        end)
    end,
    
    Stop = function()
        if ConnectionHandlers.KillAura then
            ConnectionHandlers.KillAura:Disconnect()
            ConnectionHandlers.KillAura = nil
        end
        CurrentTarget = nil
    end
}

-- SILENT AIM MODULE
Modules.SilentAim = {
    Start = function()
        -- Create FOV Circle
        if Config.SilentAim.ShowFOV or Config.FOVCircle.Enabled then
            FOVCircleDrawing = Functions.DrawCircle(
                Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2),
                Config.SilentAim.FOV,
                Config.FOVCircle.Color or Color3.fromRGB(255, 255, 255),
                Config.FOVCircle.Filled or false
            )
            FOVCircleDrawing.Thickness = Config.FOVCircle.Thickness or 1.5
            FOVCircleDrawing.Transparency = Config.FOVCircle.Transparency or 0.6
        end
        
        -- Hook Raycast
        pcall(function()
            local originalRaycast = workspace.Raycast
            OriginalFunctions.OldRaycast = originalRaycast
            
            ConnectionHandlers.SilentAim = HookMeta(workspace, "__index", function(self, index, ...)
                if index == "Raycast" and Config.SilentAim.Enabled then
                    local target, targetPos = Functions.GetNearestToCrosshair(Config.SilentAim.FOV)
                    
                    if target and (math.random(1, 100) <= Config.SilentAim.HitChance) then
                        local wallCheck = not Config.SilentAim.WallCheck or Functions.HasLineOfSight(targetPos)
                        
                        if wallCheck then
                            local origin = Camera.CFrame.Position
                            local direction = (targetPos - origin).Unit
                            
                            return {
                                Position = targetPos,
                                Instance = Functions.GetRootPart(Functions.GetCharacter(target)),
                                Material = Enum.Material.Plastic,
                                Normal = -direction
                            }
                        end
                    end
                end
                
                return originalRaycast(self, index, ...)
            end)
        end)
        
        -- Update FOV Circle
        table.insert(Connections, Services.RunService.RenderStepped:Connect(function()
            if FOVCircleDrawing then
                FOVCircleDrawing.Position = Vector2.new(
                    Camera.ViewportSize.X / 2, 
                    Camera.ViewportSize.Y / 2
                )
                FOVCircleDrawing.Radius = Config.SilentAim.FOV
                FOVCircleDrawing.Visible = Config.SilentAim.Enabled or Config.FOVCircle.Enabled
            end
        end))
    end,
    
    Stop = function()
        if ConnectionHandlers.SilentAim and OriginalFunctions.OldRaycast then
            pcall(function()
                HookMeta(workspace, "__index", OriginalFunctions.OldRaycast)
            end)
            ConnectionHandlers.SilentAim = nil
        end
        
        if FOVCircleDrawing then
            FOVCircleDrawing:Remove()
            FOVCircleDrawing = nil
        end
    end
}

-- AIMBOT MODULE
Modules.Aimbot = {
    Start = function()
        ConnectionHandlers.Aimbot = Services.RunService.RenderStepped:Connect(function()
            if not Config.Aimbot.Enabled then return end
            
            local target, targetPos = Functions.GetNearestToCrosshair(180)
            
            if target and targetPos then
                local cameraCF = Camera.CFrame
                local targetCF = CFrame.new(cameraCF.Position, targetPos)
                local smoothedCF = cameraCF:Lerp(targetCF, Config.Aimbot.Smoothness)
                
                Camera.CFrame = smoothedCF
            end
        end)
    end,
    
    Stop = function()
        if ConnectionHandlers.Aimbot then
            ConnectionHandlers.Aimbot:Disconnect()
            ConnectionHandlers.Aimbot = nil
        end
    end
}

