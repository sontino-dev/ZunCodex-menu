local function UpdateESP()
    for player,obj in pairs(ESPObjects) do
        local show=C.ESP.E and IA(player) and player~=LocalPlayer
        local tcp=not C.ESP.TC or not IPT(player)
        
        if show and tcp then
            local char=GC(player);local hum=GH(char);local root=GR(char)
            local myRoot=GR(GC(LocalPlayer))
            
            if char and hum and root and myRoot then
                local dist=GD(myRoot.Position,root.Position)
                if dist<=C.ESP.MD then
                    obj.Gui.Enabled=true
                    obj.Gui.Adornee=root
                    
                    if C.ESP.SN then
                        obj.Nl.Visible=true
                        obj.Nl.Text=player.Name
                        if C.ESP.TC and player.Team then
                            obj.Nl.TextColor3=player.TeamColor.Color
                        end
                    else
                        obj.Nl.Visible=false
                    end
                    
                    if C.ESP.SD then
                        obj.Dl.Visible=true
                        obj.Dl.Text="["..math.floor(dist).."]"
                    else
                        obj.Dl.Visible=false
                    end
                    
                    if C.ESP.SH then
                        obj.Hl.Visible=true
                        local hp=GHP(hum)
                        obj.Hl.Text=math.floor(hum.Health).." HP"
                        if hp>60 then obj.Hl.TextColor3=Color3.new(0,1,0)
                        elseif hp>30 then obj.Hl.TextColor3=Color3.new(1,1,0)
                        else obj.Hl.TextColor3=Color3.new(1,0,0) end
                    else
                        obj.Hl.Visible=false
                    end
                    
                    if C.ESP.ST then
                        local tool=char:FindFirstChildOfClass("Tool")
                        if tool then
                            obj.Tl.Visible=true
                            obj.Tl.Text=tool.Name
                        else
                            obj.Tl.Visible=false
                        end
                    else
                        obj.Tl.Visible=false
                    end
                else
                    obj.Gui.Enabled=false
                end
            else
                obj.Gui.Enabled=false
            end
        else
            obj.Gui.Enabled=false
        end
    end
    
    for player,hl in pairs(HighlightObjects) do
        local show=C.CH.E and IA(player) and player~=LocalPlayer
        local tcp=not C.ESP.TC or not IPT(player)
        if show and tcp then
            hl.Enabled=true
            hl.FillColor=C.CH.IC
            hl.OutlineColor=C.CH.OC
            hl.FillTransparency=C.CH.T
        else
            hl.Enabled=false
        end
    end
end

