-- ESP MODULE (đã hoàn chỉnh)
Modules.ESP = {
    Start = function()
        if Connections.ESP then return end
        Connections.ESP = Services.RunService.RenderStepped:Connect(function()
            if not Config.ESP.Enabled then return end
            
            for _, pl in pairs(Functions.GetAllPlayers()) do
                if not Functions.IsAlive(pl) then
                    if ESPData[pl.UserId] then
                        for _, drawing in pairs(ESPData[pl.UserId]) do
                            if drawing and drawing.Visible ~= nil then drawing.Visible = false end
                        end
                    end
                    continue
                end
                
                local char = Functions.GetCharacter(pl)
                local root = Functions.GetRootPart(char)
                if not root then
                    if ESPData[pl.UserId] then
                        for _, drawing in pairs(ESPData[pl.UserId]) do
                            if drawing and drawing.Visible ~= nil then drawing.Visible = false end
                        end
                    end
                    continue
                end
                
                local screenPos, onScreen = Functions.WorldToScreen(root.Position)
                if not onScreen or not screenPos then
                    if ESPData[pl.UserId] then
                        for _, drawing in pairs(ESPData[pl.UserId]) do
                            if drawing and drawing.Visible ~= nil then drawing.Visible = false end
                        end
                    end
                    continue
                end
                
                local myPos = Functions.GetPosition(Player)
                local dist = Functions.Distance(myPos, root.Position)
                if dist > Config.ESP.MaxDistance then
                    if ESPData[pl.UserId] then
                        for _, drawing in pairs(ESPData[pl.UserId]) do
                            if drawing and drawing.Visible ~= nil then drawing.Visible = false end
                        end
                    end
                    continue
                end
                
                local isEnemy = not Functions.IsTeammate(pl)
                local color = isEnemy and Config.ESP.EnemyColor or Config.ESP.TeamColor
                
                if not ESPData[pl.UserId] then
                    ESPData[pl.UserId] = {
                        Box = CreateDrawing("Square"),
                        Name = CreateDrawing("Text"),
                        Health = CreateDrawing("Text"),
                        Distance = CreateDrawing("Text"),
                        Tool = CreateDrawing("Text"),
                        Tracer = CreateDrawing("Line")
                    }
                    local data = ESPData[pl.UserId]
                    if data.Box then data.Box.Thickness = 1; data.Box.Filled = false end
                    if data.Name then data.Name.Size = Config.ESP.TextSize; data.Name.Center = true; data.Name.Outline = true end
                    if data.Health then data.Health.Size = Config.ESP.TextSize - 2; data.Health.Center = true; data.Health.Outline = true end
                    if data.Distance then data.Distance.Size = Config.ESP.TextSize - 2; data.Distance.Center = true; data.Distance.Outline = true end
                    if data.Tool then data.Tool.Size = Config.ESP.TextSize - 2; data.Tool.Center = true; data.Tool.Outline = true end
                    if data.Tracer then data.Tracer.Thickness = Config.Tracers.Thickness or 1.2 end
                end
                
                local data = ESPData[pl.UserId]
                local hum = Functions.GetHumanoid(char)
                local scaleFactor = 1 / (dist * 0.001)
                local boxHeight = 4.5 * scaleFactor
                local boxWidth = 3.5 * scaleFactor
                
                if data.Box then
                    if Config.ESP.BoxESP then
                        data.Box.Position = Vector2.new(screenPos.X - boxWidth/2, screenPos.Y - boxHeight/2)
                        data.Box.Size = Vector2.new(boxWidth, boxHeight)
                        data.Box.Color = color
                        data.Box.Visible = true
                    else
                        data.Box.Visible = false
                    end
                end
                
                if data.Name and Config.ESP.ShowNames then
                    data.Name.Position = Vector2.new(screenPos.X, screenPos.Y - boxHeight/2 - 16)
                    data.Name.Text = pl.Name
                    data.Name.Color = color
                    data.Name.Visible = true
                elseif data.Name then
                    data.Name.Visible = false
                end
                
                if data.Health and Config.ESP.ShowHealth and hum then
                    data.Health.Position = Vector2.new(screenPos.X, screenPos.Y + boxHeight/2 + 2)
                    data.Health.Text = "HP: " .. math.floor(hum.Health)
                    data.Health.Visible = true
                elseif data.Health then
                    data.Health.Visible = false
                end
                
                if data.Distance and Config.ESP.ShowDistance then
                    data.Distance.Position = Vector2.new(screenPos.X, screenPos.Y + boxHeight/2 + 16)
                    data.Distance.Text = "[" .. math.floor(dist) .. "m]"
                    data.Distance.Visible = true
                elseif data.Distance then
                    data.Distance.Visible = false
                end
                
                if data.Tool and Config.ESP.ShowTool then
                    local tool = char:FindFirstChildOfClass("Tool")
                    data.Tool.Position = Vector2.new(screenPos.X, screenPos.Y + boxHeight/2 + 30)
                    data.Tool.Text = tool and tool.Name or "None"
                    data.Tool.Visible = true
                elseif data.Tool then
                    data.Tool.Visible = false
                end
                
                if data.Tracer and Config.ESP.Tracers then
                    local fromY = Camera.ViewSize.Y
                    if Config.Tracers.FromPosition == "Center" then fromY = Camera.ViewSize.Y / 2
                    elseif Config.Tracers.FromPosition == "Top" then fromY = 0
                    elseif Config.Tracers.FromPosition == "Mouse" then fromY = Services.UserInput:GetMouseLocation().Y end
                    data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, fromY)
                    data.Tracer.To = screenPos
                    data.Tracer.Color = Config.Tracers.Color
                    data.Tracer.Visible = true
                elseif data.Tracer then
                    data.Tracer.Visible = false
                end
            end
        end)
    end,
    Stop = function()
        if Connections.ESP then
            Connections.ESP:Disconnect()
            Connections.ESP = nil
        end
        for uid, data in pairs(ESPData) do
            for _, drawing in pairs(data) do
                if drawing and drawing.Remove then
                    pcall(function() drawing:Remove() end)
                end
            end
        end
        ESPData = {}
    end
}

