-- Safe file IO wrappers
local function SafeWriteFile(name, content)
    if Executor.SupportsFileIO then
        return pcall(function() writefile(name, content) end)
    end
    return false
end

local function SafeReadFile(name)
    if Executor.SupportsFileIO then
        local success, result = pcall(function() return readfile(name) end)
        if success then return result end
    end
    return nil
end

-- Safe JSON
