-- ============================================
-- UTILITY FUNCTIONS
-- ============================================

local Functions = {
    IsValid = function(obj)
        if type(obj) ~= "userdata" then return false end
        local success, result = pcall(function() return obj and obj.Parent ~= nil end)
        return success and result == true
    end,
    
    Distance = function(a, b)
        if not a or not b then return math.huge end
        return (a - b).Magnitude
    end,
    
    GetCharacter = function(player)
        if not Functions.IsValid(player) then return nil end
        return player.Character
    end,
    
    GetHumanoid = function(char)
        if not Functions.IsValid(char) then return nil end
        return char:FindFirstChildOfClass("Humanoid")
    end,
    
    GetRootPart = function(char)
        local hum = Functions.GetHumanoid(char)
        if not hum then return nil end
        return hum.RootPart or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    end,
    
    GetPosition = function(player)
        local char = Functions.GetCharacter(player)
        local root = Functions.GetRootPart(char)
        return root and root.Position
    end,
    
    IsAlive = function(player)
        local hum = Functions.GetHumanoid(Functions.GetCharacter(player))
        return hum and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead
    end,
    
    IsTeammate = function(targetPlayer)
        local result = false
        pcall(function()
            local TeamService = getrenv().TeamService
            if TeamService then
                local myTeam = TeamService.getTeam(Player)
                local theirTeam = TeamService.getTeam(targetPlayer)
                result = myTeam and theirTeam and myTeam == theirTeam
            end
        end)
        if not result then
            if Player.Team and targetPlayer.Team then
                result = Player.Team == targetPlayer.Team
            end
        end
        return result
    end,
    
    WorldToScreen = function(position)
        if not Functions.IsValid(Camera) then return nil, false end
        local success, result = pcall(function()
            return Camera:WorldToViewportPoint(position)
        end)
        if success then
            return Vector2.new(result.X, result.Y), result.Z > 0
        end
        return nil, false
    end,
    
    GetAllPlayers = function()
        local players = {}
        for _, player in pairs(Services.Players:GetPlayers()) do
            if player ~= Player and Functions.IsValid(player) then
                table.insert(players, player)
            end
        end
        return players
    end,
    
    GetNearestEnemy = function(maxDistance)
        maxDistance = maxDistance or math.huge
        local nearest = nil
        local minDist = maxDistance
        local myPos = Functions.GetPosition(Player)
        if not myPos then return nil, math.huge end
        for _, player in pairs(Functions.GetAllPlayers()) do
            if Functions.IsAlive(player) and not Functions.IsTeammate(player) then
                local pos = Functions.GetPosition(player)
                if pos then
                    local dist = Functions.Distance(myPos, pos)
                    if dist < minDist then
                        minDist = dist
                        nearest = player
                    end
                end
            end
        end
        return nearest, minDist
    end,
    
    GetNearestToCrosshair = function(fovRadius)
        fovRadius = fovRadius or 180
        local closest = nil
        local shortestFov = fovRadius
        local bestHitPos = nil
        local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        for _, player in pairs(Functions.GetAllPlayers()) do
            if Functions.IsAlive(player) and not Functions.IsTeammate(player) then
                local char = Functions.GetCharacter(player)
                local root = Functions.GetRootPart(char)
                if root then
                    local hitPoints = {
                        {Pos = root.Position, Name = "Body"},
                        {Pos = root.Position + Vector3.new(0, 3, 0), Name = "Head"}
                    }
                    local head = char:FindFirstChild("Head")
                    if head then table.insert(hitPoints, {Pos = head.Position, Name = "Head"}) end
                    for _, point in pairs(hitPoints) do
                        local screenPos, onScreen = Functions.WorldToScreen(point.Pos)
                        if onScreen and screenPos then
                            local diff = Vector2.new(screenPos.X - mousePos.X, screenPos.Y - mousePos.Y)
                            local currentFov = math.sqrt(diff.X * diff.X + diff.Y * diff.Y)
                            if currentFov < shortestFov then
                                shortestFov = currentFov
                                closest = player
                                bestHitPos = point.Pos
                            end
                        end
                    end
                end
            end
        end
        return closest, bestHitPos
    end,
    
    HasLineOfSight = function(targetPos)
        if not Functions.IsValid(Camera) then return false end
        local origin = Camera.CFrame.Position
        local direction = (targetPos - origin)
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {Functions.GetCharacter(Player)}
        rayParams.FilterType = Enum.RaycastFilterType.Blacklist
        local result = Services.Workspace:Raycast(origin, direction.Unit * direction.Magnitude, rayParams)
        return result == nil
    end,
    
    FindRemote = function(pattern)
        for _, desc in pairs(Services.ReplicatedStorage:GetDescendants()) do
            if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") then
                if desc.Name:lower():find(pattern:lower()) then
                    return desc
                end
            end
        end
        return nil
    end,
    
    FireRemote = function(remote, ...)
        if not Functions.IsValid(remote) then return false end
        pcall(function()
            if remote:IsA("RemoteEvent") then remote:FireServer(...)
            elseif remote:IsA("RemoteFunction") then remote:InvokeServer(...) end
        end)
        return true
    end,
    
    Notify = function(message, msgType)
        msgType = msgType or "info"
        pcall(function()
            local announce = game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
                Text = "[BedWarsVIP] " .. message,
                Color = msgType == "error" and Color3.new(1,0.3,0.3) or msgType == "success" and Color3.new(0.3,1,0.3) or Color3.new(1,1,1),
                Font = Enum.Font.GothamBold
            })
        end)
    end
}

