-- Populate Settings Tab
local function PopulateSettingsTab(tabFrame)
    -- Config Save/Load Section
    CreateSectionHeader(tabFrame, "Configuration")

    local saveBtn = Instance.new("TextButton")
    saveBtn.Name = "SaveConfig"
    saveBtn.Size = UDim2.new(1, 0, 0, 30)
    saveBtn.BackgroundColor3 = Config.GUI.AccentColor
    saveBtn.BorderSizePixel = 0
    saveBtn.Text = "Save Configuration"
    saveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    saveBtn.TextSize = 14
    saveBtn.Font = Enum.Font.GothamBold
    saveBtn.Parent = tabFrame

    local saveCorner = Instance.new("UICorner")
    saveCorner.CornerRadius = UDim.new(0, 4)
    saveCorner.Parent = saveBtn

    saveBtn.MouseButton1Click:Connect(function()
        if FileIOSupported then
            local json = JSONEncode(Config)
            pcall(function()
                writefile("DeltaBedwars_config.json", json)
            end)
            print("[DeltaBedwars] Config saved!")
        else
            warn("[DeltaBedwars] File I/O not supported on this executor")
        end
    end)

    local loadBtn = Instance.new("TextButton")
    loadBtn.Name = "LoadConfig"
    loadBtn.Size = UDim2.new(1, 0, 0, 30)
    loadBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 200)
    loadBtn.BorderSizePixel = 0
    loadBtn.Text = "Load Configuration"
    loadBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    loadBtn.TextSize = 14
    loadBtn.Font = Enum.Font.GothamBold
    loadBtn.Parent = tabFrame

    local loadCorner = Instance.new("UICorner")
    loadCorner.CornerRadius = UDim.new(0, 4)
    loadCorner.Parent = loadBtn

    loadBtn.MouseButton1Click:Connect(function()
        if FileIOSupported then
            local success, result = pcall(function()
                return readfile("DeltaBedwars_config.json")
            end)
            if success then
                local loadedConfig = JSONDecode(result)
                if loadedConfig then
                    -- Merge configs (simple merge)
                    for section, options in pairs(loadedConfig) do
                        if type(options) == "table" and Config[section] then
                            for key, value in pairs(options) do
                                Config[section][key] = value
                            end
                        end
                    end
                    print("[DeltaBedwars] Config loaded!")
                end
            end
        else
            warn("[DeltaBedwars] File I/O not supported on this executor")
        end
    end)

    -- Reset Config
    local resetBtn = Instance.new("TextButton")
    resetBtn.Name = "ResetConfig"
    resetBtn.Size = UDim2.new(1, 0, 0, 30)
    resetBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    resetBtn.BorderSizePixel = 0
    resetBtn.Text = "Reset to Defaults"
    resetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    resetBtn.TextSize = 14
    resetBtn.Font = Enum.Font.GothamBold
    resetBtn.Parent = tabFrame

    local resetCorner = Instance.new("UICorner")
    resetCorner.CornerRadius = UDim.new(0, 4)
    resetCorner.Parent = resetBtn

    resetBtn.MouseButton1Click:Connect(function()
        -- Reset all toggles to default (disabled)
        for section, options in pairs(Config) do
            if type(options) == "table" then
                for key, value in pairs(options) do
                    if key == "Enabled" then
                        Config[section][key] = false
                    end
                end
            end
        end
        print("[DeltaBedwars] Config reset!")
    end)

    -- Info Section
    CreateSectionHeader(tabFrame, "Information")

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Name = "InfoLabel"
    infoLabel.Size = UDim2.new(1, 0, 0, 100)
    infoLabel.BackgroundTransparency = 1
    infoLabel.Text = "DeltaBedwars V4.0\nExecutor: " .. Executor.Name .. "\nDrawing Support: " .. tostring(DrawingSupported) .. "\nFile I/O: " .. tostring(FileIOSupported) .. "\nMobile: " .. tostring(Executor.IsMobile)
    infoLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    infoLabel.TextSize = 12
    infoLabel.Font = Enum.Font.Gotham
    infoLabel.TextWrapped = true
    infoLabel.TextYAlignment = Enum.TextYAlignment.Top
    infoLabel.Parent = tabFrame

    -- GUI Keybind
    CreateSectionHeader(tabFrame, "GUI Settings")

    CreateKeybind(tabFrame, "Open/Close Key", Config.GUI, "OpenKey")
end

-- Initialize everything
local function Init()
    print("[DeltaBedwars V4.0] Loading...")
    print("[DeltaBedwars V4.0] Executor: " .. Executor.Name)
    print("[DeltaBedwars V4.0] Mobile: " .. tostring(Executor.IsMobile))
    print("[DeltaBedwars V4.0] Drawing Supported: " .. tostring(DrawingSupported))
    print("[DeltaBedwars V4.0] File I/O Supported: " .. tostring(FileIOSupported))

    -- Create GUI
    local gui, mainFrame, tabFrames = CreateGUI()

    -- Populate tabs
    PopulateCombatTab(TabFrames["Combat"])
    PopulateESPTab(TabFrames["ESP"])
    PopulateMovementTab(TabFrames["Movement"])
    PopulateUtilityTab(TabFrames["Utility"])
    PopulateBypassTab(TabFrames["Bypass"])
    PopulateVisualsTab(TabFrames["Visuals"])
    PopulateSettingsTab(TabFrames["Settings"])

    -- Setup triggerbot
    SetupTriggerbot()

    -- Create FOV Circle if drawing supported
    if DrawingSupported then
        CreateFOVCircle()
    end

    -- Main update loop
    local mainConnection = RunService.RenderStepped:Connect(function()
        -- Update ESP
        UpdateESP()

        -- Update FOV Circle
        UpdateFOVCircle()

        -- Kill Aura
        KillAuraLoop()

        -- Aimbot
        AimbotLoop()

        -- Bed Nuker
        BedNukerLoop()
    end)

    -- Player added/removed handling
    local playerAddedConn = Players.PlayerAdded:Connect(function(player)
        if Config.ESP.Enabled then
            CreateESP(player)
        end
        if Config.Chams.Enabled then
            CreateChams(player)
        end
    end)

    local playerRemovingConn = Players.PlayerRemoving:Connect(function(player)
        RemoveESP(player)
    end)

    -- GUI toggle keybind
    local guiToggleConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Config.GUI.OpenKey then
            if ScreenGui then
                ScreenGui.Enabled = not ScreenGui.Enabled
            end
        end

        -- Feature keybinds
        if not gameProcessed then
            -- Fly toggle
            if input.KeyCode == Config.Fly.Key then
                Config.Fly.Enabled = not Config.Fly.Enabled
                if Config.Fly.Enabled then
                    StartFly()
                else
                    StopFly()
                end
            end

            -- NoClip toggle
            if input.KeyCode == Config.NoClip.Key then
                Config.NoClip.Enabled = not Config.NoClip.Enabled
                if Config.NoClip.Enabled then
                    StartNoClip()
                else
                    StopNoClip()
                end
            end

            -- AutoBridge toggle
            if input.KeyCode == Config.AutoBridge.Key then
                Config.AutoBridge.Enabled = not Config.AutoBridge.Enabled
                if Config.AutoBridge.Enabled then
                    StartAutoBridge()
                else
                    StopAutoBridge()
                end
            end
        end
    end)

    -- Cleanup function
    getgenv().DeltaBedwarsCleanup = function()
        print("[DeltaBedwars V4.0] Cleaning up...")

        if mainConnection then
            pcall(function() mainConnection:Disconnect() end)
        end
        if playerAddedConn then
            pcall(function() playerAddedConn:Disconnect() end)
        end
        if playerRemovingConn then
            pcall(function() playerRemovingConn:Disconnect() end)
        end
        if guiToggleConn then
            pcall(function() guiToggleConn:Disconnect() end)
        end
        if TriggerbotConnection then
            pcall(function() TriggerbotConnection:Disconnect() end)
        end

        StopFly()
        StopNoClip()
        StopInfiniteJump()
        StopAntiVoid()
        StopNoFallDamage()
        StopHighJump()
        StopAutoBridge()
        StopAutoClicker()
        StopAntiAim()
        StopGodMode()
        StopNoCooldown()

        -- Remove all ESP
        for player, _ in pairs(ESPObjects) do
            RemoveESP(player)
        end
        for player, _ in pairs(BillboardGUIs) do
            RemoveESP(player)
        end
        for player, _ in pairs(HighlightObjects) do
            RemoveESP(player)
        end

        -- Remove FOV Circle
        if FOVCircleObj then
            pcall(function() FOVCircleObj:Remove() end)
        end

        -- Remove GUI
        if ScreenGui then
            pcall(function() ScreenGui:Destroy() end)
        end

        print("[DeltaBedwars V4.0] Cleanup complete!")
    end

    print("[DeltaBedwars V4.0] Loaded successfully!")
    print("[DeltaBedwars V4.0] Press " .. tostring(Config.GUI.OpenKey):split(".")[2] .. " to toggle GUI")
    print("[DeltaBedwars V4.0] Run DeltaBedwarsCleanup() to unload")
end

-- Run initialization
pcall(Init)
