local function PopSettings(tf)
    SHeader(tf,"Configuration")
    
    local sv=Instance.new("TextButton");sv.Name="SaveCfg";sv.Size=UDim2.new(1,0,0,28)
    sv.BackgroundColor3=C.GUI.AC;sv.BorderSizePixel=0;sv.Text="Save Configuration"
