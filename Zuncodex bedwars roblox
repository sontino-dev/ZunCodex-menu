        "\nFileIO: "..tostring(Executor.SupportsFileIO).."\nHooks: "..tostring(Executor.SupportsHooks)
    il.TextColor3=Color3.fromRGB(170,170,170);il.TextSize=11;il.Font=Enum.Font.Gotham
    il.TextWrapped=true;il.TextYAlignment=Enum.TextYAlignment.Top;il.Parent=tf
    
    SHeader(tf,"GUI Settings")
    SKeybind(tf,"Open/Close Key",C.GUI,"OK")
end

-- ====== INITIALIZATION =====_
local function Init()
    print("[DBW V4.0] Loading...")
    
    local gui,mf,tfs=CreateGUI()
    
    PopCombat(TFS["Combat"])
    PopESP(TFS["ESP"])
    PopMovement(TFS["Movement"])
    PopUtility(TFS["Utility"])
    PopBypass(TFS["Bypass"])
    PopVisuals(TFS["Visuals"])
    PopSettings(TFS["Settings"])
    
    SetupTB()
    if Executor.SupportsDrawing then CreateFOV() end
    
    -- Main Loop
    local ML=RunService.RenderStepped:Connect(function()
        UpdateESP();UpdateFOV();KillAura();AimbotLoop();BedNuker()
    end)
    
    -- Player Handling
    local PA=Players.PlayerAdded:Connect(function(p)
        if C.ESP.E then CreateESP(p) end
        if C.CH.E then CreateChams(p) end
    end)
    local PR=Players.PlayerRemoving:Connect(function(p) RemoveESP(p) end)
    
    -- Input Handling
    local IH=UserInputService.InputBegan:Connect(function(i,gp)
        if not gp and i.KeyCode==C.GUI.OK then
            if SG then SG.Enabled=not SG.Enabled end
        end
        if not gp then
            if i.KeyCode==C.MOV.FL.K then
                C.MOV.FL.E=not C.MOV.FL.E
                if C.MOV.FL.E then StartFly() else StopFly() end
            end
            if i.KeyCode==C.MOV.NC.K then
                C.MOV.NC.E=not C.MOV.NC.E
                if C.MOV.NC.E then StartNC() else StopNC() end
            end
            if i.KeyCode==C.UT.AB.K then
                C.UT.AB.E=not C.UT.AB.E
                if C.UT.AB.E then StartAB() else StopAB() end
            end
        end
    end)
    
    -- Cleanup Function
    getgenv().DBWCleanup=function()
        print("[DBW V4.0] Cleaning up...")
        if ML then pcall(function()ML:Disconnect()end) end
        if PA then pcall(function()PA:Disconnect()end) end
        if PR then pcall(function()PR:Disconnect()end) end
        if IH then pcall(function()IH:Disconnect()end) end
        if TBC then pcall(function()TBC:Disconnect()end) end
        StopFly();StopNC();StopIJ();StopAV();StopNFD();StopHJ()
        StopAB();StopAC();StartAA();StopGM();StopNC2()
        for p,_ in pairs(ESPObjects) do RemoveESP(p) end
        for p,_ in pairs(HighlightObjects) do RemoveESP(p) end
        if FOVObj then pcall(function()FOVObj:Remove()end) end
        if SG then pcall(function()SG:Destroy()end) end
        print("[DBW V4.0] Cleanup complete!")
    end
    
    print("[DBW V4.0] Loaded! Press "..tostring(C.GUI.OK):split(".")[2].." to toggle GUI")
    print("[DBW V4.0] Run DBWCleanup() to unload")
end

pcall(Init)
