local function CreateChams(player)
    if HighlightObjects[player] then return end

    local character = GetCharacter(player)
    if not character then return end

    -- Check if highlight already exists
    local existingHighlight = character:FindFirstChild("ESP_Highlight")
    if existingHighlight then
        HighlightObjects[player] = existingHighlight
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = Config.Chams.InsideColor
    highlight.OutlineColor = Config.Chams.OutsideColor
    highlight.FillTransparency = Config.Chams.Transparency
    highlight.OutlineTransparency = 0
    highlight.Adornee = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    highlight.Parent = character

    HighlightObjects[player] = highlight
end

local function RemoveESP(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            pcall(function() obj:Remove() end)
        end
        ESPObjects[player] = nil
    end

    if BillboardGUIs[player] then
        pcall(function() BillboardGUIs[player].Gui:Destroy() end)
        BillboardGUIs[player] = nil
    end

    if HighlightObjects[player] then
        pcall(function() HighlightObjects[player]:Destroy() end)
        HighlightObjects[player] = nil
    end
end

local function UpdateESP()
    for player, objects in pairs(ESPObjects) do
        local shouldShow = Config.ESP.Enabled and IsAlive(player) and player ~= LocalPlayer
        local teamCheckPass = not Config.ESP.TeamCheck or not IsPlayerTeam(player)

        if shouldShow and teamCheckPass then
            local character = GetCharacter(player)
            local humanoid = GetHumanoid(character)
            local rootPart = GetRootPart(character)

            if character and humanoid and rootPart then
                local position = rootPart.Position
                local screenPos, onScreen = WorldToScreenPoint(position)
                local myRoot = GetRootPart(GetCharacter(LocalPlayer))

                if onScreen and myRoot then
                    local distance = GetDistance(myRoot.Position, position)

                    if distance <= Config.ESP.MaxDistance then
                        -- Calculate box dimensions
                        local cf = CFrame.new(Camera.CFrame.Position, position)
                        local headPos = (character:FindFirstChild("Head") and character.Head.Position) or position + Vector3.new(0, 1.5, 0)
                        local legPos = (character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.Position - Vector3.new(0, 3, 0)) or position - Vector3.new(0, 3, 0)

                        local headScreen = WorldToScreenPoint(headPos)
                        local legScreen = WorldToScreenPoint(legPos)

                        local height = math.abs(headScreen.Y - legScreen.Y)
                        local width = height * 0.6

                        local x = screenPos.X - width / 2
                        local y = legScreen.Y

                        -- Team color
                        local teamColor = Color3.fromRGB(255, 255, 255)
                        if Config.ESP.TeamColor and player.Team then
                            teamColor = player.TeamColor.Color
                        end

                        -- Update Box
                        if Config.ESP.BoxEnabled then
                            objects.Box.Visible = true
                            objects.Box.Position = Vector2.new(x, y)
                            objects.Box.Size = Vector2.new(width, height)
                            objects.Box.Color = teamColor

                            if Config.ESP.BoxOutline then
                                objects.BoxOutline.Visible = true
                                objects.BoxOutline.Position = Vector2.new(x, y)
                                objects.BoxOutline.Size = Vector2.new(width, height)
                            else
                                objects.BoxOutline.Visible = false
                            end
                        else
                            objects.Box.Visible = false
                            objects.BoxOutline.Visible = false
                        end

                        -- Update Name
                        if Config.ESP.ShowName then
                            objects.Name.Visible = true
                            objects.Name.Position = Vector2.new(screenPos.X, y - 18)
                            objects.Name.Text = player.Name
                            objects.Name.Color = teamColor
                        else
                            objects.Name.Visible = false
                        end

                        -- Update Distance
                        if Config.ESP.ShowDistance then
                            objects.Distance.Visible = true
                            objects.Distance.Position = Vector2.new(screenPos.X, y + height + 16)
                            objects.Distance.Text = string.format("[%d]", math.floor(distance))
                        else
                            objects.Distance.Visible = false
                        end

                        -- Update Health
                        if Config.ESP.ShowHealth then
                            local healthPercent = GetHealthPercent(humanoid)
                            objects.Health.Visible = true
                            objects.Health.Position = Vector2.new(screenPos.X, y + height + 32)
                            objects.Health.Text = string.format("%d%%", math.floor(healthPercent))
                            if healthPercent > 60 then
                                objects.Health.Color = Color3.fromRGB(0, 255, 0)
                            elseif healthPercent > 30 then
                                objects.Health.Color = Color3.fromRGB(255, 255, 0)
                            else
                                objects.Health.Color = Color3.fromRGB(255, 0, 0)
                            end
                        else
                            objects.Health.Visible = false
                        end

                        -- Update Tool
                        if Config.ESP.ShowTool then
                            local tool = player.Character:FindFirstChildOfClass("Tool")
                            if tool then
                                objects.Tool.Visible = true
                                objects.Tool.Position = Vector2.new(screenPos.X, y + height + 48)
                                objects.Tool.Text = tool.Name
                            else
                                objects.Tool.Visible = false
                            end
                        else
                            objects.Tool.Visible = false
                        end

                        -- Update Tracer
                        if Config.Tracers.Enabled then
                            objects.Tracer.Visible = true
                            objects.Tracer.Color = Config.Tracers.Color
                            objects.Tracer.Thickness = Config.Tracers.Thickness

                            local fromPos
                            if Config.Tracers.From == "Mouse" then
                                fromPos = UserInputService:GetMouseLocation()
                            elseif Config.Tracers.From == "Center" then
                                fromPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                            else -- Bottom
                                fromPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            end

                            objects.Tracer.From = fromPos
                            objects.Tracer.To = Vector2.new(screenPos.X, y + height / 2)
                        else
                            objects.Tracer.Visible = false
                        end

                        -- Update Health Bar
                        if Config.ESP.HealthBar then
                            local healthPercent = GetHealthPercent(humanoid)
                            local barHeight = height
                            local barWidth = 4

                            objects.HealthBarBG.Visible = true
                            objects.HealthBarBG.From = Vector2.new(x - barWidth - 4, y)
                            objects.HealthBarBG.To = Vector2.new(x - barWidth - 4, y + barHeight)

                            objects.HealthBar.Visible = true
                            local currentHeight = barHeight * (healthPercent / 100)
                            objects.HealthBar.From = Vector2.new(x - barWidth - 4, y + barHeight - currentHeight)
                            objects.HealthBar.To = Vector2.new(x - barWidth - 4, y + barHeight)

                            if healthPercent > 60 then
                                objects.HealthBar.Color = Color3.fromRGB(0, 255, 0)
                            elseif healthPercent > 30 then
                                objects.HealthBar.Color = Color3.fromRGB(255, 255, 0)
                            else
                                objects.HealthBar.Color = Color3.fromRGB(255, 0, 0)
                            end
                        else
                            objects.HealthBarBG.Visible = false
                            objects.HealthBar.Visible = false
                        end
                    else
                        SetAllVisible(objects, false)
                    end
                else
                    SetAllVisible(objects, false)
                end
            else
                SetAllVisible(objects, false)
            end
        else
            SetAllVisible(objects, false)
        end
    end

    -- Update Billboard GUIs (for non-Drawing support)
    for player, guiData in pairs(BillboardGUIs) do
        local shouldShow = Config.ESP.Enabled and IsAlive(player) and player ~= LocalPlayer
        local teamCheckPass = not Config.ESP.TeamCheck or not IsPlayerTeam(player)

        if shouldShow and teamCheckPass then
            local character = GetCharacter(player)
            local humanoid = GetHumanoid(character)
            local rootPart = GetRootPart(character)
            local myRoot = GetRootPart(GetCharacter(LocalPlayer))

            if character and humanoid and rootPart and myRoot then
                local distance = GetDistance(myRoot.Position, rootPart.Position)

                if distance <= Config.ESP.MaxDistance then
                    guiData.Gui.Enabled = true
                    guiData.Gui.Adornee = rootPart

                    if Config.ESP.ShowName then
                        guiData.Name.Visible = true
                        guiData.Name.Text = player.Name
                    else
                        guiData.Name.Visible = false
                    end

                    if Config.ESP.ShowDistance then
                        guiData.Distance.Visible = true
                        guiData.Distance.Text = string.format("[%d]", math.floor(distance))
                    else
                        guiData.Distance.Visible = false
                    end

                    if Config.ESP.ShowHealth then
                        local healthPercent = GetHealthPercent(humanoid)
                        guiData.Health.Visible = true
                        guiData.Health.Text = string.format("%d HP", math.floor(humanoid.Health))
                    else
                        guiData.Health.Visible = false
                    end
                else
                    guiData.Gui.Enabled = false
                end
            else
                guiData.Gui.Enabled = false
            end
        else
            guiData.Gui.Enabled = false
        end
    end

    -- Update Highlights (Chams)
    for player, highlight in pairs(HighlightObjects) do
        local shouldShow = Config.Chams.Enabled and IsAlive(player) and player ~= LocalPlayer
        local teamCheckPass = not Config.ESP.TeamCheck or not IsPlayerTeam(player)

        if shouldShow and teamCheckPass then
            highlight.Enabled = true
            highlight.FillColor = Config.Chams.InsideColor
            highlight.OutlineColor = Config.Chams.OutsideColor
            highlight.FillTransparency = Config.Chams.Transparency
        else
            highlight.Enabled = false
        end
    end
end

