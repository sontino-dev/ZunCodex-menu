--- Toggle GUI visibility
function GUI:Toggle()
    if self.Instance then
        self.Visible = not self.Visible
        self.Instance.Enabled = self.Visible
    end
end

--- Switch between tabs
---@param tabName string
function GUI:SwitchTab(tabName)
    -- Hide all tab content
    for name, content in pairs(self.Tabs) do
        if content then
            content.Visible = (name == tabName)
        end
    end
    
    -- Update button styles
    for i, btn in pairs(self.TabButtons) do
        local btnName = btn.Name:gsub("Tab$", "")
        if btnName == tabName then
            btn.BackgroundColor3 = Color3.fromRGB(60, 90, 180)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
            btn.TextColor3 = Color3.fromRGB(140, 140, 160)
        end
    end
end

