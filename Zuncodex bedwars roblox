-- Safe function wrappers with pcall
local HookFunction = function(...)
    local args = {...}
    if hookfunction then
        local success, result = pcall(hookfunction, unpack(args))
        if success then return result end
    end
    return args[1]
end

local HookMeta = function(...)
    local args = {...}
    if hookmetamethod then
        local success, result = pcall(hookmetamethod, unpack(args))
        if success then return result end
    end
    return args[2]
end

local GetConnections = function(obj)
    if getconnections then
        local success, result = pcall(getconnections, obj)
        if success then return result end
    end
    return {}
end

