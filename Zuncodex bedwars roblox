Modules.AutoBridge = {
    Start = function()
        ConnectionHandlers.AutoBridge = Services.RunService.RenderStepped:Connect(function()
            if not Config.AutoBridge.Enabled then return end
            
            local myChar = Functions.GetCharacter(Player)
            local myRoot = Functions.GetRootPart(myChar)
            if not myRoot then return end
            
            local pos = myRoot.Position
            local cf = myRoot.CFrame
            
            local direction = cf.LookVector
            if Config.AutoBridge.Direction == "Forward" then
                direction = cf.LookVector
            elseif Config.AutoBridge.Direction == "Backward" then
                direction = -cf.LookVector
            elseif Config.AutoBridge.Direction == "Left" then
                direction = -cf.RightVector
            elseif Config.AutoBridge.Direction == "Right" then
                direction = cf.RightVector
            end
            
            local placeRemote = Functions.FindRemote("placeBlock") or Functions.FindRemote("build")
            
            for i = 1, Config.AutoBridge.Length do
                if not Config.AutoBridge.Enabled then break end
                
                local buildPos = pos + (direction * (i * 3))
                
                if Config.AutoBridge.StairMode then
                    buildPos = Vector3.new(buildPos.X, buildPos.Y + (i * 3), buildPos.Z)
                end
                
                if placeRemote then
                    Functions.FireRemote(placeRemote, buildPos)
                end
                
                task.wait(Config.AutoBridge.AutoPlaceDelay)
            end
        end)
    end,
    
    Stop = function()
        if ConnectionHandlers.AutoBridge then
            ConnectionHandlers.AutoBridge:Disconnect()
            ConnectionHandlers.AutoBridge = nil
        end
    end
}

