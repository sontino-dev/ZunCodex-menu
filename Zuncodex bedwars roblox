local ESPObjs = {}

function UpdateESP()
    if not Cfg.ESP.On then
        for _,o in pairs(ESPObjs) do
            if o and o.Gui then o.Gui:Destroy() end
        end
        ESPObjs = {}
        return
    end
    
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Players
    if Cfg.ESP.Player then
        for _,p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                if phrp then
                    local dist = (phrp.Position - hrp.Position).Magnitude
                    if dist <= Cfg.ESP.MaxDist then
                        local key = "P_"..p.Name
                        if not ESPObjs[key] then
                            local head = p.Character:FindFirstChild("Head")
                            if head then
                                local bg = Instance.new("BillboardGui")
                                bg.Name = "ZESP_"..p.Name
                                bg.Adornee = head
                                bg.Size = UDim2.new(0,200,0,100)
                                bg.StudsOffset = Vector3.new(0,3,0)
                                bg.AlwaysOnTop = true
                                bg.Parent = p.Character
                                
                                local nl = Instance.new("TextLabel")
                                nl.Size = UDim2.new(1,0,0,20)
                                nl.BackgroundTransparency = 1
                                nl.Text = p.Name
                                nl.TextColor3 = Color3.fromRGB(255,50,50)
                                nl.TextSize = 14
                                nl.Font = Enum.Font.GothamBold
                                nl.Parent = bg
                                
                                local dl = Instance.new("TextLabel")
                                dl.Size = UDim2.new(1,0,0,16)
                                dl.Position = UDim2.new(0,0,1,-20)
                                dl.BackgroundTransparency = 1
                                dl.Text = ""
                                dl.TextColor3 = Color3.fromRGB(255,255,255)
                                dl.TextSize = 12
                                dl.Font = Enum.Font.Gotham
                                dl.Parent = bg
                                
                                ESPObjs[key] = {Gui=bg, NameLabel=nl, DistLabel=dl}
                            end
                        end
                        
                        local esp = ESPObjs[key]
                        if esp and esp.Gui then
                            esp.DistLabel.Text = "["..math.floor(dist).."m]"
                            esp.Gui.Enabled = true
                        end
                    elseif ESPObjs["P_"..p.Name] then
                        ESPObjs["P_"..p.Name].Gui.Enabled = false
                    end
                end
            end
        end
    end
    
    -- NPCs
    if Cfg.ESP.NPC then
        for _,npc in pairs(WS.Npcs:GetChildren()) do
            if npc:FindFirstChild("Humanoid") and npc:FindFirstChild("HumanoidRootPart") then
                local nrp = npc.HumanoidRootPart.Position
                local dist = (nrp - hrp.Position).Magnitude
                if dist <= Cfg.ESP.MaxDist then
                    local key = "N_"..npc.Name
                    if not ESPObjs[key] then
                        local head = npc:FindFirstChild("Head")
                        if head then
                            local bg = Instance.new("BillboardGui")
                            bg.Name = "ZESP_"..npc.Name
                            bg.Adornee = head
                            bg.Size = UDim2.new(0,200,0,100)
                            bg.StudsOffset = Vector3.new(0,3,0)
                            bg.AlwaysOnTop = true
                            bg.Parent = npc
                            
                            local nl = Instance.new("TextLabel")
                            nl.Size = UDim2.new(1,0,0,20)
                            nl.BackgroundTransparency = 1
                            nl.Text = npc.Name
                            nl.TextColor3 = Color3.fromRGB(50,255,50)
                            nl.TextSize = 14
                            nl.Font = Enum.Font.GothamBold
                            nl.Parent = bg
                            
                            local dl = Instance.new("TextLabel")
                            dl.Size = UDim2.new(1,0,0,16)
                            dl.Position = UDim2.new(0,0,1,-20)
                            dl.BackgroundTransparency = 1
                            dl.Text = ""
                            dl.TextColor3 = Color3.fromRGB(255,255,255)
                            dl.TextSize = 12
                            dl.Font = Enum.Font.Gotham
                            dl.Parent = bg
                            
                            ESPObjs[key] = {Gui=bg, NameLabel=nl, DistLabel=dl}
                        end
                    end
                    
                    local esp = ESPObjs[key]
                    if esp and esp.Gui then
                        esp.DistLabel.Text = "["..math.floor(dist).."m]"
                        esp.Gui.Enabled = true
                    end
                end
            end
        end
    end
end

function FindTarget()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local best = nil
    local bestDist = Cfg.Combat.Dist
    local closest = math.huge
    local lowestHP = math.huge
    
    for _,npc in pairs(WS.Npcs:GetChildren()) do
        local hum = npc:FindFirstChild("Humanoid")
        local nrp = npc:FindFirstChild("HumanoidRootPart")
        
        if hum and nrp and hum.Health > 0 then
            local dist = (nrp.Position - hrp.Position).Magnitude
            if dist <= Cfg.Combat.Dist then
                local target = false
                
                if Cfg.Combat.Mode == "Closest" then
                    if dist < closest then
                        closest = dist
                        target = true
                    end
                elseif Cfg.Combat.Mode == "LowestHP" then
                    if hum.Health < lowestHP then
                        lowestHP = hum.Health
                        target = true
                    end
                end
                
                if target then best = npc end
            end
        end
    end
    
    return best
end

function AttackTarget(t)
    if not t then return false end
    
    local char = LP.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local thrp = t:FindFirstChild("HumanoidRootPart")
    
    if not hrp or not thrp then return false end
    
    -- Auto Buso
    if Cfg.Haki.Buso then
        local hakiVal = LP:FindFirstChild("Buso")
        if hakiVal and hakiVal.Value < Cfg.Haki.BusoHP * 10 then
            Fire("Buso")
        end
    end
    
    -- Position
    if Cfg.Combat.BringMobs then
        thrp.CFrame = hrp.CFrame * CFrame.new(0,0,5)
    else
        hrp.CFrame = thrp.CFrame * CFrame.new(0,0,5)
    end
    
    -- Attack with tool
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        Fire("Combat", t)
    end
    
    return true
end

function CombatLoop()
    if not Cfg.Combat.Enabled and not Cfg.Combat.KillAura then return end
    
    if Cfg.Combat.KillAura then
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            for _,npc in pairs(WS.Npcs:GetChildren()) do
                local hum = npc:FindFirstChild("Humanoid")
                local nrp = npc:FindFirstChild("HumanoidRootPart")
                
                if hum and nrp and hum.Health > 0 then
                    local dist = (nrp.Position - hrp.Position).Magnitude
                    if dist <= Cfg.Combat.AuraRange then
                        AttackTarget(npc)
                    end
                end
            end
        end
    elseif Cfg.Combat.Enabled then
        local t = FindTarget()
        if t then AttackTarget(t) end
    end
end

function AutoStats()
    if not Cfg.Stats.Auto then return end
    
    local stats = LP:FindFirstChild("stats")
    if not stats then return end
    
    local pts = stats:FindFirstChild("Points")
    if not pts or not pts:IsA("IntValue") or pts.Value <= Cfg.Stats.Keep then return end
    
    local alloc = pts.Value - Cfg.Stats.Keep
    if alloc <= 0 then return end
    
    local allocs = {}
    if Cfg.Stats.Melee then table.insert(allocs, "Melee") end
    if Cfg.Stats.Def then table.insert(allocs, "Defense") end
    if Cfg.Stats.Sword then table.insert(allocs, "Sword") end
    if Cfg.Stats.Gun then table.insert(allocs, "Gun") end
    
    if #allocs == 0 then return end
    
    local perStat = math.floor(alloc / #allocs)
    for _,s in pairs(allocs) do
        Fire("AddPoint", s, perStat)
    end
end

function AutoRaid()
    if not Cfg.Raid.Auto then return end
    
    local inRaid = WS:FindFirstChild("_RaidArea")
    
    if not inRaid then
        if Cfg.Raid.Join then
            Fire("JoinRaid")
        end
    else
        if Cfg.Raid.StartRaid then
            Fire("StartRaid")
        end
    end
end

function FruitSniper()
    if not Cfg.Fruit.Sniper then return end
    
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    for _,obj in pairs(WS:GetDescendants()) do
        if obj:IsA("Tool") then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                local dist = (handle.Position - hrp.Position).Magnitude
                if dist <= Cfg.Fruit.Range then
                    if Cfg.Fruit.Notify then
                        SG:SetCore("ChatMakeSystemMessage", {
                            Text = "[Zuncodex] Fruit: "..obj.Name.." at "..math.floor(dist).."m!",
                            Color = Color3.fromRGB(0,255,0)
                        })
                    end
                    
                    if Cfg.Fruit.Store then
                        hrp.CFrame = handle.CFrame
                    end
                end
            end
        end
    end
end

