function SaveConfig()
    local config = {
        Version = ScriptInfo.Version,
        SavedAt = os.time(),
        Features = {}
    }
    
    -- Deep copy features (only save enabled states and important values)
    for featName, featData in pairs(Features) do
        if type(featData) == "table" and featData.Enabled ~= nil then
            config.Features[featName] = {
                Enabled = featData.Enabled,
                Range = featData.Range,
                Speed = featData.Speed,
                Reach = featData.Reach,
                Power = featData.Power,
                FOV = featData.FOV
            }
        end
    end
    
    -- Write to file (if supported by executor)
    pcall(function()
        writefile(ScriptInfo.Name .. "_config.json", game:GetService("HttpService"):JSONEncode(config))
        print("[Delta] Config saved!")
    end)
end

function LoadConfig()
    pcall(function()
        if isfile(ScriptInfo.Name .. "_config.json") then
            local config = game:GetService("HttpService"):JSONDecode(readfile(ScriptInfo.Name .. "_config.json"))
            
            if config.Features then
                for featName, featConfig in pairs(config.Features) do
                    if Features[featName] then
                        for key, value in pairs(featConfig) do
                            Features[featName][key] = value
                        end
                    end
                end
            end
            
            print("[Delta] Config loaded!")
        end
    end)
end

function PanicMode()
    print("[Delta] PANIC MODE ACTIVATED - Disabling all features...")
    
    -- Disable all features
    for featName, featData in pairs(Features) do
        if type(featData) == "table" and featData.Enabled ~= nil then
            featData.Enabled = false
        end
    end
    
    -- Stop all running systems
    StopKillAura()
    StopSilentAim()
    StopESP()
    StopAutoScaffold()
    StopAntiVoid()
    StopFlight()
    
    -- Notify
    if GUI.StatusText then
        GUI.StatusText.Text = "PANIC"
        GUI.StatusText.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end

