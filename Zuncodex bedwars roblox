-- PHẦN 8: INITIALIZATION
-- ============================================

function Initialize()
    print("=" .. string.rep("=", 50))
    print("[Delta] " .. ScriptInfo.Name .. " v" .. ScriptInfo.Version)
    print("[Delta] Type: " .. ScriptInfo.Type)
    print("[Delta] Loading client-side modules...")
    
    -- Detect and log executor
    for name, detected in pairs(ExecutorDetect) do
        if detected then
            print("[Delta] Detected executor: " .. name)
        end
    end
    
    -- Create GUI
    GUI:Create()
    
    -- Setup input handling
    SetupKeybinds()
    
    -- Try to load saved config
    LoadConfig()
    
    -- Initialize jump power if enabled
    if Features.JumpPower.Enabled then
        local myChar = GetCharacter(LocalPlayer)
        local hum = GetHumanoid(myChar)
        if hum then
            hum.UseJumpPower = true
            hum.JumpPower = Features.JumpPower.Power
        end
    end
    
    print("[Delta] Initialization complete!")
    print("[Delta] Press " .. tostring(GUI.ToggleKey.Name) .. " to toggle GUI")
    print("=" .. string.rep("=", 50))
end

