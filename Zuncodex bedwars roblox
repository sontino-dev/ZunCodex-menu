-- Utility Functions
local function GetCharacter(player)
    if player and player.Character then
        return player.Character
    end
    return nil
end

local function GetHumanoid(character)
    if character then
        return character:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

local function GetRootPart(character)
    if character then
        return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    end
    return nil
end

local function GetHealthPercent(humanoid)
    if humanoid then
        return humanoid.Health / humanoid.MaxHealth * 100
    end
    return 100
end

local function IsAlive(player)
    local char = GetCharacter(player)
    local hum = GetHumanoid(char)
    return char ~= nil and hum ~= nil and hum.Health > 0
end

local function IsPlayerTeam(target)
    local targetTeam = target.Team
    local myTeam = LocalPlayer.Team
    if targetTeam and myTeam then
        return targetTeam == myTeam
    end
    return false
end

local function GetDistance(pos1, pos2)
    if pos1 and pos2 then
        return (pos1 - pos2).Magnitude
    end
    return math.huge
end

local function WorldToScreenPoint(position)
    if Camera and position then
        local success, result = pcall(function()
            return Camera:WorldToScreenPoint(position)
        end)
        if success then
            return result
        end
    end
    return Vector3.new(0, 0, 0), false
end

local function GetClosestPlayer(range, visibleCheck, teamCheck)
    local closest = nil
    local closestDist = range or math.huge
    local myChar = GetCharacter(LocalPlayer)
    local myRoot = GetRootPart(myChar)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if teamCheck == false or not IsPlayerTeam(player) then
                if IsAlive(player) then
                    local targetChar = GetCharacter(player)
                    local targetRoot = GetRootPart(targetChar)
                    if targetRoot and myRoot then
                        local dist = GetDistance(myRoot.Position, targetRoot.Position)
                        if dist < closestDist then
                            if visibleCheck then
                                local rayParams = RaycastParams.new()
                                rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                                rayParams.FilterDescendantsInstances = {myChar}
                                local rayResult = Workspace:Raycast(myRoot.Position, (targetRoot.Position - myRoot.Position).Unit * dist, rayParams)
                                if rayResult == nil then
                                    closest = player
                                    closestDist = dist
                                end
                            else
                                closest = player
                                closestDist = dist
                            end
                        end
                    end
                end
            end
        end
    end

    return closest, closestDist
end

local function GetClosestPlayerFromMouse(range, teamCheck)
    local closest = nil
    local closestDist = range or math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if teamCheck == false or not IsPlayerTeam(player) then
                if IsAlive(player) then
                    local targetChar = GetCharacter(player)
                    local targetRoot = GetRootPart(targetChar)
                    if targetRoot then
                        local screenPos, onScreen = WorldToScreenPoint(targetRoot.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                            if dist < closestDist then
                                closest = player
                                closestDist = dist
                            end
                        end
                    end
                end
            end
        end
    end

    return closest, closestDist
end

-- Remote Finder for Easy.gg Bedwars
local Remotes = {}
local FoundRemotes = false

local function FindRemotes()
    -- Common remote names in Easy.gg Bedwars
    local remoteNames = {
        "AttackEvent", "AttackRemote", "HitEvent", "HitRemote", "DamageEvent", "DamageRemote",
        "MeleeEvent", "SwordEvent", "SwordHit",
        "BreakBlock", "BlockBreak", "PlaceBlock", "BlockPlace",
        "HealEvent", "HealRemote", "ConsumeEvent", "UseItem",
        "BedBreak", "BedDestroy", "BreakBed",
        "BuyItem", "PurchaseEvent", "ShopEvent",
        "AbilityEvent", "AbilityRemote", "SkillEvent"
    }

    -- Search in ReplicatedStorage
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    for _, name in ipairs(remoteNames) do
        local found = ReplicatedStorage:FindFirstChild(name, true)
        if found then
            Remotes[name] = found
            FoundRemotes = true
        end
    end

    -- Also search common paths
    local paths = {
        ReplicatedStorage,
        ReplicatedStorage:FindFirstChild("Remotes"),
        ReplicatedStorage:FindFirstChild("Events"),
        ReplicatedStorage:FindFirstChild("Network"),
        ReplicatedStorage:FindFirstChild("Modules"),
    }

    for _, path in pairs(paths) do
        if path then
            for _, child in pairs(path:GetDescendants()) do
                if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                    Remotes[child.Name] = child
                    FoundRemotes = true
                end
            end
        end
    end

    return FoundRemotes
end

-- Try to find remotes
pcall(FindRemotes)

-- Fire Remote safely
local function FireRemote(remoteName, ...)
    local remote = Remotes[remoteName]
    if remote then
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(...)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(...)
            end
        end)
    end
end

