local function BedNukerLoop()
    if not Config.BedNuker.Enabled then
        BedNukerRunning = false
        return
    end

    BedNukerRunning = true

    local currentTime = tick()

    if currentTime - LastNukerTime >= Config.BedNuker.Delay then
        local character = GetCharacter(LocalPlayer)
        local rootPart = GetRootPart(character)

        if rootPart then
            -- Find beds within range
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj.Name:lower():find("bed") and obj:IsA("BasePart") or obj.Name:lower():find("bed") and obj:IsA("Model") then
                    local bedPos = obj:IsA("BasePart") and obj.Position or (obj:FindFirstChild("PrimaryPart") and obj.PrimaryPart.Position)

                    if bedPos then
                        local dist = GetDistance(rootPart.Position, bedPos)
                        if dist <= Config.BedNuker.Range then
                            FireRemote("BedBreak", obj)
                            FireRemote("BreakBed", obj)
                            LastNukerTime = currentTime
                            break
                        end
                    end
                end
            end
        end
    end
end

