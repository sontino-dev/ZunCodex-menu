--- Callback khi feature được toggle
---@param featureName string
---@param featureTable table
function GUI:OnFeatureToggled(featureName, featureTable)
    local status = featureTable.Enabled and "ENABLED" or "DISABLED"
    
    -- Update status text
    if self.StatusText then
        self.StatusText.Text = status
        self.StatusText.TextColor3 = featureTable.Enabled and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 150, 50)
    end
    if self.StatusDot then
        self.StatusDot.BackgroundColor3 = featureTable.Enabled and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 200, 50)
    end
    
    -- Feature-specific initialization/cleanup
    if featureName == "Kill Aura" then
        if featureTable.Enabled then
            StartKillAura()
        else
            StopKillAura()
        end
    elseif featureName == "Silent Aim" then
        if featureTable.Enabled then
            StartSilentAim()
        else
            StopSilentAim()
        end
    elseif featureName == "ESP" then
        if featureTable.Enabled then
            StartESP()
        else
            StopESP()
        end
    elseif featureName == "Auto Scaffold" then
        if featureTable.Enabled then
            StartAutoScaffold()
        else
            StopAutoScaffold()
        end
    elseif featureName == "Anti-Void" then
        if featureTable.Enabled then
            StartAntiVoid()
        else
            StopAntiVoid()
        end
    elseif featureName == "Flight" then
        if featureTable.Enabled then
            StartFlight()
        else
            StopFlight()
        end
    end
    
    print("[Delta] " .. featureName .. ": " .. status)
end

