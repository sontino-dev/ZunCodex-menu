    ld.BackgroundColor3=Color3.fromRGB(60,120,200);ld.BorderSizePixel=0;ld.Text="Load Configuration"
    ld.TextColor3=Color3.new(1,1,1);ld.TextSize=13;ld.Font=Enum.Font.GothamBold;ld.Parent=tf
    local ldr=Instance.new("UICorner");ldr.CornerRadius=UDim.new(0,4);ldr.Parent=ld
    ld.MouseButton1Click:Connect(function()
        local c=SafeReadFile("DeltaBedwars_V4.cfg")
        if c then
            local lc=DecodeJSON(c)
            if lc then
                for sec,opts in pairs(lc) do
                    if type(opts)=="table" and C[sec] then
                        for k,v in pairs(opts) do C[sec][k]=v end
                    end
                end
                print("[DBW] Config loaded!")
            end
        else
            warn("[DBW] Cannot load config - File IO not supported")
        end
    end)
    
    local rs=Instance.new("TextButton");rs.Name="RstCfg";rs.Size=UDim2.new(1,0,0,28)
    rs.BackgroundColor3=Color3.fromRGB(200,60,60);rs.BorderSizePixel=0;rs.Text="Reset to Defaults"
    rs.TextColor3=Color3.new(1,1,1);rs.TextSize=13;rs.Font=Enum.Font.GothamBold;rs.Parent=tf
    local rsr=Instance.new("UICorner");rsr.CornerRadius=UDim.new(0,4);rsr.Parent=rs
    rs.MouseButton1Click:Connect(function()
        for sec,opts in pairs(C) do
            if type(opts)=="table" then
                for k,v in pairs(opts) do
                    if k=="E" then C[sec][k]=false end
                end
            end
        end
        print("[DBW] Config reset!")
    end)
    
    SHeader(tf,"Information")
    local il=Instance.new("TextLabel");il.Name="Info";il.Size=UDim2.new(1,0,0,90)
    il.BackgroundTransparency=1;il.Text="DeltaBedwars V4.0 FINAL\nExecutor: "..Executor.Name..
