            if not Config.GodMode.Enabled then return end
            local myChar = Functions.GetCharacter(Player)
            local hum = Functions.GetHumanoid(myChar)
            if hum then
                if Config.GodMode.Method == "Health Lock" then
                    hum.Health = hum.MaxHealth
                elseif Config.GodMode.Method == "Blanket" then
                    hum.Health = hum.MaxHealth
                    pcall(function()
                        local damageRemote = Remotes.Damage or Functions.FindRemote("damage")
                        if damageRemote then
                            local conn = getconnections(damageRemote.OnServerEvent)
                            for _, c in pairs(conn or {}) do
                                c:Disable()
                            end
                        end
                    end)
                end
            end
        end)
    end,
    Stop = function()
        if Connections.GodMode then
            Connections.GodMode:Disconnect()
            Connections.GodMode = nil
        end
    end
}

