-- ====== UTILITY FUNCTIONS ======
local function GC(p)
    if p and p.Character then return p.Character end
    return nil
end
local function GH(c)
    if c then return c:FindFirstChildOfClass("Humanoid") end
    return nil
end
local function GR(c)
    if c then
        return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")
    end
    return nil
end
local function GHP(h)
    if h then return h.Health/h.MaxHealth*100 end
    return 100
end
local function IA(p)
    local c=GC(p);local h=GH(c)
    return c~=nil and h~=nil and h.Health>0
end
local function IPT(t)
    local tt=t.Team;local mt=LocalPlayer.Team
    if tt and mt then return tt==mt end
    return false
end
local function GD(p1,p2)
    if p1 and p2 then return (p1-p2).Magnitude end
    return math.huge
end
local function WTS(pos)
    if Camera and pos then
        local ok,r=pcall(function()return Camera:WorldToScreenPoint(pos)end)
        if ok then return r end
    end
    return Vector3.new(0,0,0),false
end
local function GCP(r,vc,tc)
    local cl=nil;local cd=r or math.huge
    local mc=GC(LocalPlayer);local mr=GR(mc)
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LocalPlayer then
            if tc==false or not IPT(p) then
                if IA(p) then
                    local pc=GC(p);local pr=GR(pc)
                    if pr and mr then
                        local d=GD(mr.Position,pr.Position)
                        if d<cd then
                            if vc then
                                local rp=RaycastParams.new()
                                rp.FilterType=Enum.RaycastFilterType.Blacklist
                                rp.FilterDescendantsInstances={mc}
                                local rr=Workspace:Raycast(mr.Position,(pr.Position-mr.Position).Unit*d,rp)
                                if rr==nil then
                                    cl=p;cd=d
                                end
                            else
                                cl=p;cd=d
                            end
                        end
                    end
                end
            end
        end
    end
    return cl,cd
end
local function GCPFM(r,tc)
    local cl=nil;local cd=r or math.huge
    local mp=UserInputService:GetMouseLocation()
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LocalPlayer then
            if tc==false or not IPT(p) then
                if IA(p) then
                    local pc=GC(p);local pr=GR(pc)
                    if pr then
                        local sp,on=WTS(pr.Position)
                        if on then
                            local d=(Vector2.new(sp.X,sp.Y)-mp).Magnitude
                            if d<cd then
                                cl=p;cd=d
                            end
                        end
                    end
                end
            end
        end
    end
    return cl,cd
end

-- ====== REMOTE SYSTEM ======
local Remotes={}
local FoundRemotes=false
local function FindRemotes()
    local names={
        "AttackEvent","AttackRemote","HitEvent","HitRemote","DamageEvent","DamageRemote",
        "MeleeEvent","SwordEvent","SwordHit",
        "BreakBlock","BlockBreak","PlaceBlock","BlockPlace",
        "HealEvent","HealRemote","ConsumeEvent","UseItem",
        "BedBreak","BedDestroy","BreakBed",
        "BuyItem","PurchaseEvent","ShopEvent"
    }
    for _,n in ipairs(names) do
        local f=ReplicatedStorage:FindFirstChild(n,true)
        if f then Remotes[n]=f;FoundRemotes=true end
    end
    local paths={ReplicatedStorage,
        ReplicatedStorage:FindFirstChild("Remotes"),
        ReplicatedStorage:FindFirstChild("Events"),
        ReplicatedStorage:FindFirstChild("Network")}
    for _,path in pairs(paths) do
        if path then
            for _,c in pairs(path:GetDescendants()) do
                if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
                    Remotes[c.Name]=c;FoundRemotes=true
                end
            end
        end
    end
end
pcall(FindRemotes)
local function FR(n,...)
    local r=Remotes[n]
    if r then
        pcall(function()
            if r:IsA("RemoteEvent") then r:FireServer(...)
            elseif r:IsA("RemoteFunction") then r:InvokeServer(...) end
        end)
    end
end

