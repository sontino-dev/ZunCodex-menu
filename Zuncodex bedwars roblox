-- PHẦN 6: INPUT HANDLING (KEYBINDS)
-- ============================================

function SetupKeybinds()
    -- GUI Toggle
    table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == GUI.ToggleKey then
            GUI:Toggle()
        elseif input.KeyCode == Features.Flight.Keybind then
            Features.Flight.Enabled = not Features.Flight.Enabled
            if Features.Flight.Enabled then
                StartFlight()
            else
                StopFlight()
            end
        elseif input.KeyCode == Features.FreeCamera.Keybind then
            Features.FreeCamera.Enabled = not Features.FreeCamera.Enabled
            -- Free camera implementation would go here
        elseif input.KeyCode == Features.AutoHeal.HealKey then
            ManualHeal()
        elseif input.KeyCode == Enum.KeyCode.Delete then
            PanicMode()
        end
    end))
    
    -- Infinite Jump
    table.insert(Connections, UserInputService.JumpRequest:Connect(function()
        if Features.JumpPower.InfiniteJump or Features.JumpPower.Enabled then
            local myChar = GetCharacter(LocalPlayer)
            local hum = GetHumanoid(myChar)
            
            if hum and (not hum.FloorMaterial or hum.FloorMaterial == Enum.Material.Air) then
                -- Allow extra jumps
                if JumpsRemaining > 0 or Features.JumpPower.InfiniteJump then
                    if not Features.JumpPower.InfiniteJump then
                        JumpsRemaining = JumpsRemaining - 1
                    end
                    
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            else
                -- Reset jumps when on ground
                JumpsRemaining = Features.JumpPower.ExtraJumps
            end
        end
    end))
    
    -- Apply jump power change
    table.insert(Connections, LocalPlayer.CharacterAdded:Connect(function(char)
        local hum = GetHumanoid(char)
        if hum then
            if Features.JumpPower.Enabled then
                hum.UseJumpPower = true
                hum.JumpPower = Features.JumpPower.Power
            end
        end
    end))
end

function ManualHeal()
    -- Trigger heal manually
    local healRemote = FindRemote("heal") or FindRemote("useItem") or FindRemote("consume")
    if healRemote then
        SafeFire(healRemote, "shears")
    end
end

