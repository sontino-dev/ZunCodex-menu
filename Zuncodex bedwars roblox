-- Fly Implementation
local FlyConnection = nil
local BodyVel = nil
local BodyGyro = nil
local Flying = false

local function StartFly()
    local character = GetCharacter(LocalPlayer)
    local rootPart = GetRootPart(character)

    if not rootPart then return end

    Flying = true

    BodyVel = Instance.new("BodyVelocity")
    BodyVel.Name = "FlyVelocity"
    BodyVel.Velocity = Vector3.new(0, 0, 0)
    BodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyVel.Parent = rootPart

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.Name = "FlyGyro"
    BodyGyro.CFrame = rootPart.CFrame
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.P = 9e4
    BodyGyro.Parent = rootPart

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not Flying or not Config.Fly.Enabled then
            StopFly()
            return
        end

        if rootPart and BodyVel and BodyGyro then
            local cameraDir = Camera.CFrame.LookVector
            local moveVec = Vector3.new(0, 0, 0)

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveVec = moveVec + Vector3.new(cameraDir.X, 0, cameraDir.Z)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveVec = moveVec - Vector3.new(cameraDir.X, 0, cameraDir.Z)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveVec = moveVec + Vector3.new(-cameraDir.Z, 0, cameraDir.X)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveVec = moveVec - Vector3.new(-cameraDir.Z, 0, cameraDir.X)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveVec = moveVec + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                moveVec = moveVec - Vector3.new(0, 1, 0)
            end

            if moveVec.Magnitude > 0 then
                moveVec = moveVec.Unit * Config.Fly.Speed
            end

            BodyVel.Velocity = moveVec
            BodyGyro.CFrame = Camera.CFrame
        end
    end)
end

local function StopFly()
    Flying = false

    if FlyConnection then
        pcall(function() FlyConnection:Disconnect() end)
        FlyConnection = nil
    end

    if BodyVel then
        pcall(function() BodyVel:Destroy() end)
        BodyVel = nil
    end

    if BodyGyro then
        pcall(function() BodyGyro:Destroy() end)
        BodyGyro = nil
    end
end

