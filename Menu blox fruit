function Zuncodex:GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

function Zuncodex:GetHumanoid()
    local char = self:GetCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

function Zuncodex:GetRootPart()
    local char = self:GetCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Zuncodex:GetPosition()
    local root = self:GetRootPart()
    return root and root.Position or Vector3.new(0, 0, 0)
end

function Zuncodex:DistanceTo(pos)
    local myPos = self:GetPosition()
    return (myPos - pos).Magnitude
end

function Zuncodex:TeleportTo(position)
    local root = self:GetRootPart()
    if root then
        root.CFrame = CFrame.new(position)
    end
end

function Zuncodex:TweenTo(position, speed)
    speed = speed or self.Config.TweenSpeed
    local root = self:GetRootPart()
    if not root then return end
    
    local tweenInfo = TweenInfo.new(
        math.max(0.1, self:DistanceTo(position) / speed),
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )
    
    local tween = TweenService:Create(root, tweenInfo, {
        CFrame = CFrame.new(position)
    })
    
    tween:Play()
    return tween
end

-- FIX CRÍTICO: Agregar local nearestDist en todas las funciones Find
function Zuncodex:FindNearestEnemy(range)
    range = range or 500
    local nearest = nil
    local nearestDist = math.huge -- FIX #1: Declarar variable correctamente
    
    local myPos = self:GetPosition()
    local myTeam = LocalPlayer.Team
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")
                
                if humanoid and humanoid.Health > 0 and root then
                    local dist = (myPos - root.Position).Magnitude
                    if dist < range and dist < nearestDist then
                        local isEnemy = true
                        if myTeam and player.Team == myTeam then
                            isEnemy = false
                        end
                        
                        if isEnemy then
                            nearest = player
                            nearestDist = dist
                        end
                    end
                end
            end
        end
    end
    
    return nearest, nearestDist
end

function Zuncodex:FindNearestNPC(range, levelMin, levelMax)
    range = range or 500
    local nearest = nil
    local nearestDist = math.huge -- FIX #2: Declarar variable correctamente
    
    local myPos = self:GetPosition()
    
    -- FIX #6: Verificar que workspace.Npcs existe
    local npcsContainer = workspace:FindFirstChild("Npcs") or workspace:FindFirstChild("NPCs") or workspace:FindFirstChild("npcs")
    if not npcsContainer then return nil, nil end
    
    for _, npc in ipairs(npcsContainer:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc:FindFirstChild("HumanoidRootPart") then
            local humanoid = npc.Humanoid
            local root = npc.HumanoidRootPart
            
            if humanoid.Health > 0 then
                local dist = (myPos - root.Position).Magnitude
                
                local levelOk = true
                if levelMin or levelMax then
                    local npcLevel = npc:FindFirstChild("Level") and npc.Level.Value or 0
                    if levelMin and npcLevel < levelMin then levelOk = false end
                    if levelMax and npcLevel > levelMax then levelOk = false end
                end
                
                if dist < range and dist < nearestDist and levelOk then
                    nearest = npc
                    nearestDist = dist
                end
            end
        end
    end
    
    return nearest, nearestDist
end

function Zuncodex:FindNearestQuestNPC(range)
    range = range or 200
    local nearest = nil
    local nearestDist = math.huge -- FIX #3: Declarar variable correctamente
    
    local myPos = self:GetPosition()
    
    local npcsContainer = workspace:FindFirstChild("Npcs") or workspace:FindFirstChild("NPCs")
    if not npcsContainer then return nil, nil end
    
    for _, npc in ipairs(npcsContainer:GetChildren()) do
        if npc:FindFirstChild("HumanoidRootPart") then
            local root = npc.HumanoidRootPart
            local dist = (myPos - root.Position).Magnitude
            
            if dist < range and dist < nearestDist then
                if npc:FindFirstChild("HasQuest") or npc:FindFirstChild("QuestGiver") then
                    nearest = npc
                    nearestDist = dist
                end
            end
        end
    end
    
    return nearest, nearestDist
end

