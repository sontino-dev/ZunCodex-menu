function Zuncodex:EnableKillAura()
    self:AddConnection("KillAura", RunService.Heartbeat:Connect(function()
        if not self.Config.KillAura then return end
        
        local range = self.Config.KillAuraRange or 50
        local myPos = self:GetPosition()
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")
                
                if humanoid and root and humanoid.Health > 0 then
                    local dist = (myPos - root.Position).Magnitude
                    if dist <= range then
                        self:AttackTarget(char)
                    end
                end
            end
        end
    end))
    
    self:Log("▶️ Kill Aura enabled (Range: " .. (self.Config.KillAuraRange or 50) .. ")")
end

function Zuncodex:DisableKillAura()
    self:RemoveConnection("KillAura")
    self:Log("⏹️ Kill Aura disabled")
end

function Zuncodex:EnableAimbot()
    self:AddConnection("Aimbot", RunService.RenderStepped:Connect(function()
        if not self.Config.Aimbot then return end
        
        local target, _ = self:FindNearestEnemy(1000)
        if target and target.Character then
            local targetPart = target.Character:FindFirstChild(self.Config.AimbotTargetPart)
            if targetPart then
                local currentCF = workspace.CurrentCamera.CFrame
                local targetCF = CFrame.lookAt(currentCF.Position, targetPart.Position)
                local smoothness = self.Config.AimbotSmoothness or 0.1
                
                workspace.CurrentCamera.CFrame = currentCF:Lerp(targetCF, smoothness)
            end
        end
    end))
    
    self:Log("▶️ Aimbot enabled")
end

function Zuncodex:DisableAimbot()
    self:RemoveConnection("Aimbot")
    self:Log("⏹️ Aimbot disabled")
end

