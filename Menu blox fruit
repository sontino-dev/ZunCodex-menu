function Zuncodex:GetPlayerLevel()
    local stats = LocalPlayer:FindFirstChild("stats") or LocalPlayer:FindFirstChild("Data")
    if stats then
        local level = stats:FindFirstChild("Level")
        if level then
            return level.Value or 1
        end
    end
    return 1
end

function Zuncodex:GetRecommendedEnemies()
    local level = self:GetPlayerLevel()
    local minLevel = math.max(1, level - 50)
    local maxLevel = level + 20
    return minLevel, maxLevel
end

function Zuncodex:StartAutoFarm()
    if self.Config.FarmMode == "LevelBased" then
        return self:StartLevelBasedFarm()
    elseif self.Config.FarmMode == "QuestBased" then
        return self:StartQuestBasedFarm()
    else
        return self:StartNormalFarm()
    end
end

function Zuncodex:StartNormalFarm()
    self:AddConnection("AutoFarm", RunService.Heartbeat:Connect(function()
        if not self.Config.AutoFarm then return end
        
        local target, dist = self:FindNearestNPC(500)
        
        if target then
            local root = target:FindFirstChild("HumanoidRootPart")
            if root then
                self:TeleportTo(root.Position + Vector3.new(0, 3, 0))
            end
            
            if self.Config.AutoHaki then
                self:ActivateHaki()
            end
            
            self:AttackTarget(target)
            
            if self.Config.AutoQuest then
                self:CheckAndAcceptQuest()
            end
        end
    end))
    
    self:Log("▶️ Normal Auto Farm started")
end

function Zuncodex:StartLevelBasedFarm()
    self:AddConnection("LevelBasedFarm", RunService.Heartbeat:Connect(function()
        if not self.Config.AutoFarm then return end
        
        local minLevel, maxLevel = self:GetRecommendedEnemies()
        local target, dist = self:FindNearestNPC(500, minLevel, maxLevel)
        
        if target then
            local root = target:FindFirstChild("HumanoidRootPart")
            if root then
                self:TeleportTo(root.Position + Vector3.new(0, 3, 0))
            end
            
            if self.Config.AutoHaki then
                self:ActivateHaki()
            end
            
            self:AttackTarget(target)
            
            if self.Config.AutoQuest then
                self:CheckAndAcceptQuest()
            end
        else
            self:Log("⚠️ No enemies found for level range ("..minLevel.."-"..maxLevel..")")
        end
    end))
    
    self:Log("▶️ Level-Based Auto Farm started")
end

function Zuncodex:StartQuestBasedFarm()
    self:AddConnection("QuestBasedFarm", RunService.Heartbeat:Connect(function()
        if not self.Config.AutoFarm then return end
        
        local questNPC, questTarget = self:GetCurrentQuestInfo()
        
        if questTarget then
            local target = self:FindQuestTarget(questTarget)
            if target then
                local root = target:FindFirstChild("HumanoidRootPart")
                if root then
                    self:TeleportTo(root.Position + Vector3.new(0, 3, 0))
                end
                
                if self.Config.AutoHaki then
                    self:ActivateHaki()
                end
                
                self:AttackTarget(target)
            else
                if questNPC and self.Config.TeleportToQuest then
                    self:TeleportToQuestNPC(questNPC)
                end
            end
        else
            if self.Config.AutoQuest then
                self:AcceptNearestQuest()
            end
        end
    end))
    
    self:Log("▶️ Quest-Based Auto Farm started")
end

function Zuncodex:StopAutoFarm()
    self:RemoveConnection("AutoFarm")
    self:RemoveConnection("LevelBasedFarm")
    self:RemoveConnection("QuestBasedFarm")
    self:Log("⏹️ Auto Farm stopped")
end

