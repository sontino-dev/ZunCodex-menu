function AntiBan:HumanDelay()
    if getgenv().JJJ.AntiBan.Enabled then
        local base = Utils.RandomDelay(0.1, 0.3)
        if self.ActionCount % 10 == 0 then
            base = base + Utils.RandomDelay(0.5, 1.0)
        end
        self.ActionCount = self.ActionCount + 1
        task.wait(base)
    end
end

function AntiBan:RandomPause()
    if math.random(1, 20) == 1 then
        task.wait(Utils.RandomDelay(1, 3))
    end
end

