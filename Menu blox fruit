    if self.GUI and self.GUI.LogFrame and self.GUI.LogText then
        local currentText = self.GUI.LogText.Text
        if #currentText > 5000 then
            currentText = currentText:sub(-3000)
        end
        self.GUI.LogText.Text = currentText .. "\n[" .. timestamp .. "] " .. message
        self.GUI.LogText.CanvasPosition = Vector2.new(0, 99999)
    end
end

