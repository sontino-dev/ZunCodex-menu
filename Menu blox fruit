            if item then
                self:TeleportTo(item.Position)
                pcall(function()
                    if firetouchinterest then
                        firetouchinterest(item, self:GetRootPart(), 0)
                        firetouchinterest(item, self:GetRootPart(), 1)
                    end
                end)
                safeWait(0.5)
            end
        end
    end))
    
    self:Log("▶️ Auto Farm Materials started")
