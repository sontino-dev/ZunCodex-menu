-- ============================================================

function Zuncodex:Init()
    print("[Zuncodex V5.1] Initializing Mobile Edition...")
    
    -- Apply initial settings
    self:UpdateFPS()
    self:UpdateNoClip()
    self:UpdateFly()
    self:UpdateAntiAFK()
    
    -- Start main loop
    self:StartMainLoop()
    
    -- Notify user
    SG:SetCore("ChatMakeSystemMessage", {
        Text = "[Zuncodex V5.1] ✅ Loaded! Press [Z] button to open menu",
        Color = Color3.fromRGB(138, 43, 226)
    })
    
    print("[Zuncodex V5.1] Ready! GUI Hidden. Click [Z] logo to open.")
    print("[Zuncodex V5.1] Platform: " .. (isMobile and "Mobile" or "PC"))
    
    return self
end

-- AUTO START
Zuncodex:Init()

-- Return for external use
return Zuncodex
