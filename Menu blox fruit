-- ============================================================

local MainLoopConnection = nil

function Zuncodex:StartMainLoop()
    if MainLoopConnection then return end  -- Already running
    
    MainLoopConnection = RunS.RenderStepped:Connect(function(delta)
        -- Combat
        self:CombatLoop()
        
        -- ESP
        self:UpdateESP()
        
        -- Auto Stats (with internal cooldown)
        self:AutoStatsLoop()
        
        -- Auto Raid (with internal cooldown)
        self:AutoRaidLoop()
        
        -- Fruit Sniper (optimized)
        self:FruitSniperLoop()
        
        -- Boss Check
        self:CheckBosses()
        
        -- Character Stats
        self:UpdateCharacterStats()
    end)
end

function Zuncodex:StopMainLoop()
    if MainLoopConnection then
        MainLoopConnection:Disconnect()
        MainLoopConnection = nil
    end
end

