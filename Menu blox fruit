-- ESP System (Fixed: Cache objects, no per-frame creation)
local ESPObjects = {}

function Zuncodex:UpdateESP()
    if not Config.ESPEnabled then
        -- Clean up all ESP objects
        for key, obj in pairs(ESPObjects) do
            if obj and obj.Gui then
                obj.Gui:Destroy()
            end
        end
        ESPObjects = {}
        return
    end
    
    local char = LP.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- ESP for Players
    if Config.ESPPlayers then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LP and player.Character then
                local phrp = player.Character:FindFirstChild("HumanoidRootPart")
                if phrp then
                    local distance = (phrp.Position - hrp.Position).Magnitude
                    
                    if distance <= Config.ESPMaxDist then
                        local key = "Player_" .. player.Name
                        
                        -- Only create if not exists (FIXED: No leak!)
                        if not ESPObjects[key] then
                            local head = player.Character:FindFirstChild("Head")
                            if head then
                                local bgui = Instance.new("BillboardGui")
                                bgui.Name = "ZuncodexESP"
                                bgui.Adornee = head
                                bgui.Size = UDim2.new(0, 200, 0, 100)
                                bgui.StudsOffset = Vector3.new(0, 3, 0)
                                bgui.AlwaysOnTop = true
                                bgui.Parent = player.Character
                                
                                local nameLbl = Instance.new("TextLabel")
                                nameLbl.Size = UDim2.new(1, 0, 0, 20)
                                nameLbl.BackgroundTransparency = 1
                                nameLbl.Text = player.Name
                                nameLbl.TextColor3 = Color3.fromRGB(255, 50, 50)
                                nameLbl.TextSize = 14
                                nameLbl.Font = Enum.Font.GothamBold
                                nameLbl.Parent = bgui
                                
                                local distLbl = Instance.new("TextLabel")
                                distLbl.Size = UDim2.new(1, 0, 0, 16)
                                distLbl.Position = UDim2.new(0, 0, 1, -20)
                                distLbl.BackgroundTransparency = 1
                                distLbl.Text = ""
                                distLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                                distLbl.TextSize = 12
                                distLbl.Font = Enum.Font.Gotham
                                distLbl.Parent = bgui
                                
