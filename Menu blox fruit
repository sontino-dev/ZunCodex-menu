    local Indicator = Instance.new("Frame")
    Indicator.Name = "Indicator"
    Indicator.Size = UDim2.new(0, 18, 0, 18)
    Indicator.Position = UDim2.new(0, 3, 0.5, -9)
    Indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Indicator.BorderSizePixel = 0
    Indicator.Parent = ToggleBtn
    
    local IndCorner = Instance.new("UICorner")
    IndCorner.CornerRadius = UDim.new(0, 9)
    IndCorner.Parent = Indicator
    
    -- Get/Set config value
    local function getValue()
        return Config[configKey]
    end
    
    local function setValue(val)
        Config[configKey] = val
    end
    
    -- Update visual
    local function updateVisual(state)
        if state then
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)  -- Green when ON
            Indicator.Position = UDim2.new(0, 23, 0.5, -9)
        else
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)  -- Gray when OFF
            Indicator.Position = UDim2.new(0, 3, 0.5, -9)
        end
    end
    
    -- Initialize
    local currentState = getValue()
    updateVisual(currentState)
    
    -- Click handler (Fixed: Proper Connect syntax)
    ToggleBtn.MouseButton1Click:Connect(function()
        currentState = not currentState
        setValue(currentState)
        updateVisual(currentState)
        
        if callback then
            callback(currentState)
        end
    end)
    
    return ToggleFrame
end

