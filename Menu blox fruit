-- SPLIT FUNCTION (Lua 5.1 compatible)
local function split(str, sep)
    if type(str) ~= "string" then return {} end
    sep = sep or "%s"
    local t = {}
    for s in string.gmatch(str..sep, "(.-)"..sep) do
        table.insert(t, s)
    end
    return t
end
string.split = split

-- REMOTE (with error handling)
local CommF_ = nil
pcall(function()
    CommF_ = RS:WaitForChild("Remotes"):WaitForChild("CommF_", 10)
end)

local function Invoke(...)
    if not CommF_ then return nil end
    local ok, ret = pcall(function()
        return CommF_:InvokeServer(...)
    end)
    return ok and ret or nil
end

local function Fire(...)
    if not CommF_ then return false end
    local ok = pcall(function()
        CommF_:FireServer(...)
    end)
    return ok
end

