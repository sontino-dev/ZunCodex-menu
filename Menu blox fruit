function Zuncodex:EnableESP()
    self:DisableESP()
    self.ESPEnabled = true
    
    self:AddConnection("ESPUpdate", RunService.RenderStepped:Connect(function()
        if not self.Config.ESP_Enabled then return end
        
        self:UpdateESPPlayers()
        self:UpdateESPNPCs()
        self:UpdateESPBosses()
        self:UpdateESPFruits()
        self:UpdateESPItems()
        self:UpdateESPChests()
        self:UpdateESPSeaEvents()
    end))
    
    self:Log("▶️ ESP Enabled")
end

function Zuncodex:DisableESP()
    self.ESPEnabled = false
    self:RemoveConnection("ESPUpdate")
    
    for _, highlight in pairs(self.Highlights) do
        pcall(function() highlight:Destroy() end)
    end
    self.Highlights = {}
    
    for _, gui in pairs(self.ESPObjects) do
        pcall(function() gui:Destroy() end)
    end
    self.ESPObjects = {}
    
    self:Log("⏹️ ESP Disabled")
end

function Zuncodex:CreateHighlight(object, color)
    if not object then return nil end
    
    for existingObj, highlight in pairs(self.Highlights) do
        if existingObj == object then
            highlight.FillColor = color
            return highlight
        end
    end
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Adornee = object
    highlight.Parent = object
    
    self.Highlights[object] = highlight
    return highlight
end

function Zuncodex:CreateESPLabel(object, text, color)
    if not object then return nil end
    
    local root = object:FindFirstChild("HumanoidRootPart") or 
                  object:FindFirstChild("Head") or 
                  object:FindFirstChild("Handle")
    
    if not root then return nil end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = root
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.5
    label.Text = text
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 14
    label.Parent = billboard
    
    table.insert(self.ESPObjects, billboard)
    return billboard
end

function Zuncodex:UpdateESPPlayers()
    if not self.Config.ESP_Players then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            
            if humanoid and root then
                local dist = self:DistanceTo(root.Position)
                if dist <= self.Config.ESP_MaxDistance then
                    self:CreateHighlight(char, self.Config.ESP_ColorPlayers)
                    
                    local text = player.Name
                    if self.Config.ESP_ShowHealth then
                        text = text .. " [" .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) .. "]"
                    end
                    if self.Config.ESP_ShowDistance then
                        text = text .. " (" .. math.floor(dist) .. "m)"
                    end
                    
                    self:CreateESPLabel(char, text, self.Config.ESP_ColorPlayers)
                end
            end
        end
    end
end

