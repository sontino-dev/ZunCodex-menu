            if gameProcessed then return end
            if inputObj.UserInputType == Enum.UserInputType.MouseButton1 and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                local mouse = LocalPlayer:GetMouse()
                if mouse.Target then
                    self:TeleportTo(mouse.Target.Position + Vector3.new(0, 3, 0))
                    self:Log("📍 Teleported to: " .. tostring(mouse.Target.Position))
                end
            end
        end))
        
        self:Log("▶️ Click Teleport enabled (CTRL + Click)")
    else
        self:Log("⏹️ Click Teleport disabled")
    end
end

