    if Config.ESPNPCs then
        local npcsFolder = WS:FindFirstChild("Npcs")
        if npcsFolder then
            for _, npc in pairs(npcsFolder:GetChildren()) do
                local humanoid = npc:FindFirstChild("Humanoid")
                local nrhp = npc:FindFirstChild("HumanoidRootPart")  -- Fixed: Full path
                
                if humanoid and nrhp then
                    local distance = (nrhp.Position - hrp.Position).Magnitude
                    
                    if distance <= Config.ESPMaxDist then
                        local key = "NPC_" .. npc.Name
                        
                        if not ESPObjects[key] then
                            local head = npc:FindFirstChild("Head")
                            if head then
                                local bgui = Instance.new("BillboardGui")
                                bgui.Name = "ZuncodexESP"
                                bgui.Adornee = head
                                bgui.Size = UDim2.new(0, 200, 0, 100)
                                bgui.StudsOffset = Vector3.new(0, 3, 0)
                                bgui.AlwaysOnTop = true
                                bgui.Parent = npc
                                
