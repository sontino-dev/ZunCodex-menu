function Zuncodex:CheckForUpdate(githubRawUrl)
    githubRawUrl = githubRawUrl or "https://raw.githubusercontent.com/palofsc/Zuncodex/main/ZuncodexV41.lua"
    
    local success, result = pcall(function()
        local response = game:HttpGet(githubRawUrl)
        
        local remoteVersion = response:match('Version%s*=%s*"([^"]+)"')
        
        if remoteVersion and remoteVersion ~= self.Version then
            self:Log("🆕 New version available: " .. remoteVersion .. " (Current: " .. self.Version .. ")")
            return true, remoteVersion
        else
            self:Log("✅ You're on the latest version!")
            return false, self.Version
        end
    end)
    
    if not success then
        self:Log("⚠️ Could not check for updates")
        return false, self.Version
    end
end

function Zuncodex:EnableAutoUpdate(githubUrl)
    githubUrl = githubUrl or "https://raw.githubusercontent.com/palofsc/Zuncodex/main/ZuncodexV41.lua"
    
    self:AddConnection("AutoUpdate", spawn(function()
        while self.Running do
            safeWait(3600) -- Check every hour
            if self.Config.AutoUpdate then
                local hasUpdate, newVersion = self:CheckForUpdate(githubUrl)
                if hasUpdate then
                    self:Log("🔄 Auto-updating to " .. newVersion)
                    self:LoadFromURL(githubUrl)
                    break
                end
            end
        end
    end))
    
    self:Log("▶️ Auto Update enabled (checks every hour)")
end

function Zuncodex:LoadFromURL(url)
    pcall(function()
        local response = game:HttpGet(url)
        loadstring(response)()
        self:Log("✅ Loaded from URL: " .. url)
    end)
end

