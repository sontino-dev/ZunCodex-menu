function Zuncodex:StartWeaponUnlock(weaponName)
    if not self.Config.WeaponUnlocker[weaponName] then return end
    
    local weapon = self.Config.WeaponUnlocker[weaponName]
    weapon.Enabled = true
    
    self:AddConnection("Weapon_" .. weaponName, RunService.Heartbeat:Connect(function()
        if not weapon.Enabled then return end
        
        weapon.Progress = math.min(weapon.MaxProgress, weapon.Progress + 0.001)
        
        if weapon.Progress >= weapon.MaxProgress then
            self:Log("⚔️ " .. weaponName .. " unlocked!")
            weapon.Enabled = false
            self:RemoveConnection("Weapon_" .. weaponName)
        end
    end))
    
    self:Log("▶️ " .. weaponName .. " unlock progress started")
end

