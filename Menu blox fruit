function Zuncodex:ToggleWalkOnWater(enable)
    self:RemoveConnection("WalkOnWater")
    
    if enable then
        self:AddConnection("WalkOnWater", RunService.Heartbeat:Connect(function()
            if not self.Config.WalkOnWater then return end
            
            local root = self:GetRootPart()
            if root then
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {self:GetCharacter()}
                
                local result = workspace:Raycast(root.Position, Vector3.new(0, -10, 0), rayParams)
                if result and result.Instance.Name:find("Water") then
                    local platform = Instance.new("Part")
                    platform.Size = Vector3.new(5, 1, 5)
                    platform.Transparency = 1
                    platform.Anchored = true
                    platform.CanCollide = true
                    platform.Position = root.Position - Vector3.new(0, 3, 0)
                    platform.Parent = workspace
                    game:GetService("Debris"):AddItem(platform, 0.1)
                end
            end
        end))
        self:Log("▶️ Walk on Water enabled")
    else
        self:Log("⏹️ Walk on Water disabled")
    end
end

function Zuncodex:ToggleFly(enable)
    self:RemoveConnection("Fly")
    
    if enable then
        local flySpeed = self.Config.FlySpeed or 100
        local flying = false
        local bodyVel = nil
        local bodyGyro = nil -- FIX #13: Declarar local bodyGyro correctamente
        
        self:AddConnection("Fly", RunService.RenderStepped:Connect(function()
            if not self.Config.FlyMode then 
                if flying then
                    flying = false
                    if bodyVel then bodyVel:Destroy() end
                    if bodyGyro then bodyGyro:Destroy() end
                end
                return 
            end
            
            local root = self:GetRootPart()
            local humanoid = self:GetHumanoid()
            if not root or not humanoid then return end
            
            if not flying then
                flying = true
                
                bodyVel = Instance.new("BodyVelocity")
                bodyVel.Velocity = Vector3.new(0, 0, 0)
                bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bodyVel.Parent = root
                
                bodyGyro = Instance.new("BodyGyro") -- Ahora sí está declarado
                bodyGyro.CFrame = root.CFrame
                bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bodyGyro.P = 9e4
                bodyGyro.Parent = root
                
                humanoid.PlatformStand = true
            end
            
            local camera = workspace.CurrentCamera
            local moveDir = Vector3.new(0, 0, 0)
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveDir = moveDir + camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveDir = moveDir - camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveDir = moveDir - camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveDir = moveDir + camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveDir = moveDir + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                moveDir = moveDir - Vector3.new(0, 1, 0)
            end
            
            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit * flySpeed
                bodyVel.Velocity = moveDir
                bodyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + moveDir)
            else
                bodyVel.Velocity = Vector3.new(0, 0, 0)
            end
        end))
        
        self:Log("▶️ Fly mode enabled (Speed: " .. flySpeed .. ")")
    else
        local humanoid = self:GetHumanoid()
        if humanoid then
            humanoid.PlatformStand = false
        end
        self:Log("⏹️ Fly mode disabled")
    end
end

