function Zuncodex:AttackTarget(target)
    if not target then return end
    
    local humanoid = target:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local attackCount = self.Config.FastAttackEnabled and self.Config.FastAttackMultiplier or 1
    
    for i = 1, attackCount do
        if self.Config.SkillZ then
            self:UseSkill("Z", target)
        end
        safeWait(self.Config.SkillHoldTime)
        
        if self.Config.SkillX then
            self:UseSkill("X", target)
        end
        safeWait(self.Config.SkillHoldTime)
        
        if self.Config.SkillC then
            self:UseSkill("C", target)
        end
        safeWait(self.Config.SkillHoldTime)
        
        if self.Config.SkillV then
            self:UseSkill("V", target)
        end
        safeWait(self.Config.SkillHoldTime)
    end
end

function Zuncodex:UseSkill(skillKey, target)
    pcall(function()
        if self.Remotes.Attack then
            self.Remotes.Attack:FireServer(skillKey, self.Config.WeaponType)
        end
        
        local skillRemote = self.Remotes[self.Config.WeaponType]
        if skillRemote then
            skillRemote:FireServer(skillKey)
        end
    end)
end

