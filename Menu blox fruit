-- Fly System (FIXED #34: Added existence check)
ZuncodexV5_1.FlyConnection = nil
ZuncodexV5_1.Flying = false
ZuncodexV5_1.FlyVelocity = nil

function ZuncodexV5_1:ToggleFly()
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if self.Config.Misc.Fly then
        if not self.Flying then
            self.Flying = true
            
            -- Create fly velocity
            if not self.FlyVelocity then
                self.FlyVelocity = Instance.new("BodyVelocity")
                self.FlyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                self.FlyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
            
            self.FlyVelocity.Parent = hrp
            
            -- Update loop
            self.FlyConnection = RunService.RenderStepped:Connect(function()
                if not self.Config.Misc.Fly or not self.Flying then
                    self:ToggleFly()
                    return
                end
                
                local char = LocalPlayer.Character
                if not char then return end
                
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp or not self.FlyVelocity or not self.FlyVelocity.Parent then return end
                
                local cameraCF = Camera.CFrame
                local moveDir = Vector3.new(0, 0, 0)
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    moveDir = moveDir + cameraCF.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    moveDir = moveDir - cameraCF.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    moveDir = moveDir - cameraCF.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    moveDir = moveDir + cameraCF.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    moveDir = moveDir + Vector3.new(0, 1, 0)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                    moveDir = moveDir - Vector3.new(0, 1, 0)
                end
                
                if moveDir.Magnitude > 0 then
                    moveDir = moveDir.Unit * self.Config.Misc.FlySpeed
                end
                
                self.FlyVelocity.Velocity = moveDir
            end)
        end
    else
        self.Flying = false
        
        if self.FlyConnection then
            self.FlyConnection:Disconnect()
            self.FlyConnection = nil
        end
        
        if self.FlyVelocity then
            self.FlyVelocity:Destroy()
            self.FlyVelocity = nil
        end
    end
end

