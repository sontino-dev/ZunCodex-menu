-- Switch tab function
function ZuncodexV5_1:SwitchTab(tabName)
    -- Deactivate all tabs
    for _, tab in pairs(tabs) do
        tab.Button.BackgroundColor3 = ZuncodexV5_1.Config.Theme.Secondary
        tab.Button.TextColor3 = ZuncodexV5_1.Config.Theme.TextSecondary
        tab.Content.Visible = false
    end
    
    -- Activate selected tab
    for _, tab in pairs(tabs) do
        if tab.Name == tabName then
            tab.Button.BackgroundColor3 = ZuncodexV5_1.Config.Theme.Accent
            tab.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
            tab.Content.Visible = true
            currentTab = tab
            break
        end
    end
end

