function Zuncodex:StartAutoFarmMaterials()
    self:AddConnection("FarmMaterials", RunService.Heartbeat:Connect(function()
        if not self.Config.AutoFarmMaterials then return end
        
        local materialTypes = {"Scrap Metal", "Dragon Scale", "Fish Tail", "Fist", "Ghost Fragment"}
        
        for _, matType in ipairs(materialTypes) do
