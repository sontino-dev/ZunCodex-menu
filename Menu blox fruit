-- ESP System (FIXED #32: No more per-frame BillboardGui creation)
ZuncodexV5_1.ESPObjecs = {}  -- Cache ESP objects
ZuncodexV5_1.ESPRunning = false

function ZuncodexV5_1:CreateESPObject(character, espType)
    local humanoid = character:FindFirstChild("Humanoid")
    local head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
    
    if not humanoid or not head or not torso then return nil end
    
    local espObj = Instance.new("BillboardGui")
    espObj.Name = "ZuncodexESP_" .. character.Name
    espObj.Adornee = head
    espObj.Size = UDim2.new(0, 200, 0, 100)
    espObj.StudsOffset = Vector3.new(0, 3, 0)
    espObj.AlwaysOnTop = true
    espObj.Parent = character
    
    -- Name label
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = character.Name
    nameLabel.TextColor3 = espType == "Player" and self.Config.ESP.PlayerColor or 
                          espType == "NPC" and self.Config.ESP.NPCColor or 
                          self.Config.ESP.FruitColor
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = espObj
    
    -- Distance label
    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "DistanceLabel"
    distLabel.Size = UDim2.new(1, 0, 0, 16)
    distLabel.Position = UDim2.new(0, 0, 1, -20)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = ""
    distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    distLabel.TextSize = 12
    distLabel.Font = Enum.Font.Gotham
    distLabel.Parent = espObj
    
    -- Box (optional)
    local box = Instance.new("Frame")
    box.Name = "Box"
    box.Size = UDim2.new(0, 4, 1, 0)
    box.Position = UDim2.new(0.5, -2, 0, 0)
    box.BackgroundColor3 = nameLabel.TextColor3
    box.BorderSizePixel = 0
    box.Visible = false
    box.Parent = espObj
    
    return {
        Gui = espObj,
        NameLabel = nameLabel,
        DistLabel = distLabel,
        Box = box,
        Character = character
    }
end

function ZuncodexV5_1:UpdateESP()
    if not self.Config.ESP.Enabled then
        -- Clean up all ESP objects
        for _, obj in pairs(self.ESPObjecs) do
            if obj and obj.Gui then
                obj.Gui:Destroy()
            end
        end
        self.ESPObjecs = {}
        self.ESPRunning = false
        return
    end
    
    if not self.ESPRunning then
        self.ESPRunning = true
    end
    
    local localChar = LocalPlayer.Character
    if not localChar then return end
    
    local localHRP = localChar:FindFirstChild("HumanoidRootPart")
    if not localHRP then return end
    
    local maxDist = self.Config.ESP.MaxDistance
    
    -- Update Players
    if self.Config.ESP.ShowPlayers then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                
                if hrp then
                    local distance = (hrp.Position - localHRP.Position).Magnitude
                    
                    if distance <= maxDist then
                        -- Check if ESP object exists
                        local espKey = "Player_" .. player.Name
                        if not self.ESPObjecs[espKey] then
                            self.ESPObjecs[espKey] = self:CreateESPObject(char, "Player")
                        end
                        
                        local esp = self.ESPObjecs[espKey]
                        if esp and esp.Gui and esp.Gui.Parent then
                            esp.DistLabel.Text = string.format("[%d m]", math.floor(distance))
                            
                            -- Update visibility based on distance
                            esp.Gui.Enabled = true
                        end
                    else
                        -- Too far, disable
                        local espKey = "Player_" .. player.Name
                        if self.ESPObjecs[espKey] and self.ESPObjecs[espKey].Gui then
                            self.ESPObjecs[espKey].Gui.Enabled = false
                        end
                    end
                end
            end
        end
    end
    
    -- Update NPCs (similar pattern, using workspace NPCs)
    if self.Config.ESP.ShowNPCs then
        for _, npc in pairs(Workspace.Npcs:GetChildren()) do
            if npc:FindFirstChild("Humanoid") and npc:FindFirstChild("HumanoidRootPart") then
                local hrp = npc.HumanoidRootPart
                local distance = (hrp.Position - localHRP.Position).Magnitude
                
                if distance <= maxDist then
                    local espKey = "NPC_" .. npc.Name
                    if not self.ESPObjecs[espKey] then
                        self.ESPObjecs[espKey] = self:CreateESPObject(npc, "NPC")
                    end
                    
                    local esp = self.ESPObjecs[espKey]
                    if esp and esp.Gui and esp.Gui.Parent then
                        esp.DistLabel.Text = string.format("[%d m]", math.floor(distance))
                        esp.Gui.Enabled = true
                    end
                end
            end
        end
    end
end

-- Combat System (FIXED: Proper target finding)
ZuncodexV5_1.CurrentTarget = nil
ZuncodexV5_1.CombatRunning = false

function ZuncodexV5_1:FindTarget()
    local localChar = LocalPlayer.Character
    if not localChar then return nil end
    
    local localHRP = localChar:FindFirstChild("HumanoidRootPart")
    if not localHRP then return nil end
    
    local bestTarget = nil
    local bestDistance = self.Config.Combat.AttackDistance
    local closestDist = math.huge
    local lowestHP = math.huge
    local highestBounty = 0
    
    -- Search NPCs
    for _, npc in pairs(Workspace.Npcs:GetChildren()) do
        local humanoid = npc:FindFirstChild("Humanoid")
        local hrp = npc:FindFirstChild("HumanoidRootPart")
        
        if humanoid and hrp and humanoid.Health > 0 then
            local distance = (hrp.Position - localHRP.Position).Magnitude
            
            if distance <= self.Config.Combat.AttackDistance then
                local shouldTarget = false
                
                if self.Config.Combat.TargetMode == "Closest" then
                    if distance < closestDist then
                        closestDist = distance
                        shouldTarget = true
                    end
                elseif self.Config.Combat.TargetMode == "LowestHP" then
                    if humanoid.Health < lowestHP then
                        lowestHP = humanoid.Health
                        shouldTarget = true
                    end
                elseif self.Config.Combat.TargetMode == "HighestBounty" then
                    -- Check for bounty (would need game-specific implementation)
                    shouldTarget = distance < closestDist
                    closestDist = distance
                end
                
                if shouldTarget then
                    bestTarget = npc
                end
            end
        end
    end
    
    return bestTarget
end

function ZuncodexV5_1:AttackTarget(target)
    if not target then return false end
    
    local localChar = LocalPlayer.Character
    if not localChar then return false end
    
    local localHRP = localChar:FindFirstChild("HumanoidRootPart")
    local targetHRP = target:FindFirstChild("HumanoidRootPart")
    
    if not localHRP or not targetHRP then return false end
    
    -- Move to target
    if self.Config.Combat.BringMobs then
        -- Bring mobs to player (using CFrame)
        targetHRP.CFrame = localHRP.CFrame * CFrame.new(0, 0, 5)
    else
        -- Move player to target
        localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 5)
    end
    
    -- Auto Haki check (FIXED: Using correct config path)
    if self.Config.Haki.AutoBuso then
        local hakiValue = LocalPlayer:FindFirstChild("Buso") or 
                          LocalPlayer:FindFirstChild("HakiValue")
        if hakiValue and (type(hakiValue) == "number" or hakiValue:IsA("IntValue")) then
            local val = type(hakiValue) == "number" and hakiValue or hakiValue.Value
            if val < self.Config.Haki.BusoThreshold then
                safeFire("Buso")
            end
        end
    end
    
    -- Attack (using tool or combat system)
    local tool = localChar:FindFirstChildOfClass("Tool")
    if tool then
        -- Try to activate tool
        local activate = tool:FindFirstChild("Activate")
        if activate then
            safeFire(activate, target)
        end
    end
    
    -- Also try direct combat remote
    safeFire("Combat", target)
    
    return true
end

function ZuncodexV5_1:CombatLoop()
    if not self.Config.Combat.Enabled and not self.Config.Combat.KillAura then
        self.CombatRunning = false
        self.CurrentTarget = nil
        return
    end
    
    self.CombatRunning = true
    
    -- Kill Aura mode
    if self.Config.Combat.KillAura then
        local targets = {}
        local localChar = LocalPlayer.Character
        local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
        
        if localHRP then
            for _, npc in pairs(Workspace.Npcs:GetChildren()) do
                local humanoid = npc:FindFirstChild("Humanoid")
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                
                if humanoid and hrp and humanoid.Health > 0 then
                    local distance = (hrp.Position - localHRP.Position).Magnitude
                    if distance <= self.Config.Combat.AuraRange then
                        table.insert(targets, npc)
                    end
                end
            end
            
            -- Attack all targets in range
            for _, target in pairs(targets) do
                self:AttackTarget(target)
            end
        end
    elseif self.Config.Combat.Enabled then
        -- Normal auto farm mode
        local target = self:FindTarget()
        if target then
            self.CurrentTarget = target
            self:AttackTarget(target)
        else
            self.CurrentTarget = nil
        end
    end
end

-- Auto Stats System (NEW in V5.1)
function ZuncodexV5_1:AutoStats()
    if not self.Config.Stats.AutoStats then return end
    
    -- Get stat points
    local stats = LocalPlayer:FindFirstChild("stats")
    if not stats then return end
    
    local points = stats:FindFirstChild("Points")
    if not points or not points:IsA("IntValue") or points.Value <= self.Config.Stats.KeepForLeveling then
        return
    end
    
    local allocPoints = points.Value - self.Config.Stats.KeepForLeveling
    if allocPoints <= 0 then return end
    
    -- Distribute points
    local allocations = {}
    if self.Config.Stats.Melee then table.insert(allocations, "Melee") end
    if self.Config.Stats.Defense then table.insert(allocations, "Defense") end
    if self.Config.Stats.Sword then table.insert(allocations, "Sword") end
    if self.Config.Stats.Gun then table.insert(allocations, "Gun") end
    
    if #allocations == 0 then return end
    
    local pointsPerStat = math.floor(allocPoints / #allocations)
    
    for _, stat in ipairs(allocations) do
        safeFire("AddPoint", stat, pointsPerStat)
    end
end

