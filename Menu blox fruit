function Zuncodex:StartBossFarm()
    self:AddConnection("BossFarm", RunService.Heartbeat:Connect(function()
        if not self.Config.AutoFarmBoss then return end
        
        local shouldWait, waitTime = self:ShouldWaitForRespawn()
        if shouldWait then
            if waitTime > 240 and self.Config.ServerHopNoBoss then
                self:ServerHop()
            end
            return
        end
        
        local boss, dist = self:FindAnySelectedBoss(10000)
        
        if boss then
            local humanoid = boss:FindFirstChild("Humanoid")
            local root = boss:FindFirstChild("HumanoidRootPart")
            
            if humanoid and root and humanoid.Health > 0 then
                self:TeleportTo(root.Position + Vector3.new(0, 5, 0))
                self:AttackTarget(boss)
                
                if humanoid.Health <= 0 then
                    self.LastBossKillTime = tick()
                    self:Log("💀 Boss defeated: " .. boss.Name)
                    
                    if self.Config.WebhookEnabled and self.Config.WebhookURL ~= "" then
                        self:SendWebhook("Boss Defeated", "Successfully killed **" .. boss.Name .. "**!")
                    end
                    
                    if self.Config.AutoAwaken then
                        self:TryAwakenFragments()
                    end
                end
            end
        else
            self:Log("🔍 No selected bosses found nearby...")
            
            if self.Config.ServerHopNoBoss then
                self:ServerHop()
            end
        end
    end))
    
    self:Log("▶️ Auto Boss Farm started (FIXED)")
end

function Zuncodex:StopBossFarm()
    self:RemoveConnection("BossFarm")
    self:Log("⏹️ Auto Boss Farm stopped")
end

