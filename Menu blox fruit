-- CONFIG SAVE/LOAD SYSTEM - CON PCALL (FIXED)
-- ═══════════════════════════════════════════════════════════════════════════

function Zuncodex:SaveConfig()
    local success, err = pcall(function()
        -- Verificar que writefile existe
        if not writefile then return end
        
        local configCopy = {}
        for k, v in pairs(self.Config) do
            configCopy[k] = v
        end
        
        local http = game:GetService("HttpService")
        local jsonStr = http:JSONEncode(configCopy)
        
        pcall(function()
            writefile("zuncodex_config.json", jsonStr)
            self:Log("✅ Config saved successfully!")
        end)
    end)
    
    if not success then
        self:Log("⚠️ Could not save config (executor may not support file I/O)")
    end
end

function Zuncodex:LoadConfig()
    local success, err = pcall(function()
        -- Verificar que readfile/isfile existen
        if not isfile or not readfile then return end
        
        pcall(function()
            if isfile("zuncodex_config.json") then
                local content = readfile("zuncodex_config.json")
                if content and content ~= "" then
                    local http = game:GetService("HttpService")
                    local decoded = http:JSONDecode(content)
                    if type(decoded) == "table" then
                        for k, v in pairs(decoded) do
                            if self.Config[k] ~= nil then
                                self.Config[k] = v
                            end
                        end
                        self:Log("✅ Config loaded successfully!")
                    end
                end
            end
        end)
    end)
    
    if not success then
        self:Log("⚠️ No config found or error loading")
    end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- REMOTE DETECTION SYSTEM
-- ═══════════════════════════════════════════════════════════════════════════

function Zuncodex:DetectRemotes()
    self:Log("🔍 Detecting remotes...")
    local foundCount = 0
    
    pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local name = obj.Name
                for remoteKey, _ in pairs(self.Remotes) do
                    if name:lower():find(remoteKey:lower()) or 
                       name:lower():find("comm") or 
                       name:lower():find("main") then
                        self.Remotes[remoteKey] = obj
                        foundCount = foundCount + 1
                        break
                    end
                end
            end
        end
        
        if foundCount < 5 then
            for _, fallbackName in ipairs(self.RemoteFallbackNames) do
                local found = ReplicatedStorage:FindFirstChild(fallbackName, true)
                if found and (found:IsA("RemoteEvent") or found:IsA("RemoteFunction")) then
                    for remoteKey, _ in pairs(self.Remotes) do
                        if not self.Remotes[remoteKey] then
                            self.Remotes[remoteKey] = found
                            foundCount = foundCount + 1
                            break
                        end
                    end
                end
            end
        end
    end)
    
    self:Log(string.format("📡 Found %d remotes", foundCount))
    return foundCount > 0
end

