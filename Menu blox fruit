function Combat:BringMob()
    spawn(function()
        while getgenv().JJJ.Settings.BringMob do
            local mob = Utils.GetNearestMob()
            if mob and mob.HumanoidRootPart then
                -- kéo về phía player
                local hrp = LP.Character.HumanoidRootPart
                local dist = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
                if dist > 20 then
                    mob.HumanoidRootPart.CFrame = hrp.CFrame + CFrame.new(0,0,-5)
                end
            end
            task.wait(0.5)
        end
    end)
end

