-- Config helpers
function ZuncodexV5_1:GetConfigValue(path)
    local keys = split(path, ".")
    local value = self.Config
    for _, key in ipairs(keys) do
        if value and type(value) == "table" then
            value = value[key]
        else
            return nil
        end
    end
    return value
end

function ZuncodexV5_1:SetConfigValue(path, newValue)
    local keys = split(path, ".")
    local config = self.Config
    for i = 1, #keys - 1 do
        if config[keys[i]] then
            config = config[keys[i]]
        else
            return false
        end
    end
    config[keys[#keys]] = newValue
    return true
end

