local function Invoke(...)
    if not CommF_ then return nil end
    local ok, ret = pcall(function() return CommF_:InvokeServer(...) end)
    return ok and ret or nil
end

local function Fire(...)
    if not CommF_ then return false end
    pcall(function() CommF_:FireServer(...) end)
    return true
end

