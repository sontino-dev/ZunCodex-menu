-- Combat System (Fixed: With cooldown)
function Zuncodex:FindBestTarget()
    local char = LP.Character
    if not char then return nil end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local bestTarget = nil
    local closestDistance = math.huge
    local lowestHealth = math.huge
    
    local npcsFolder = WS:FindFirstChild("Npcs")
    if not npcsFolder then return nil end
    
    for _, npc in pairs(npcsFolder:GetChildren()) do
        local humanoid = npc:FindFirstChild("Humanoid")
        local nrhp = npc:FindFirstChild("HumanoidRootPart")
        
        if humanoid and nrhp and humanoid.Health > 0 then
            local distance = (nrhp.Position - hrp.Position).Magnitude
            
            if distance <= Config.AttackDistance then
                local shouldTarget = false
                
                if Config.TargetMode == "Closest" then
                    if distance < closestDistance then
                        closestDistance = distance
                        shouldTarget = true
                    end
                elseif Config.TargetMode == "LowestHP" then
                    if humanoid.Health < lowestHealth then
                        lowestHealth = humanoid.Health
                        shouldTarget = true
                    end
                end
                
                if shouldTarget then
                    bestTarget = npc
                end
            end
        end
    end
    
    return bestTarget
end

function Zuncodex:AttackTarget(target)
    if not target then return false end
    
    local char = LP.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local thrp = target:FindFirstChild("HumanoidRootPart")
    
    if not hrp or not thrp then return false end
    
    -- Auto Buso
    if Config.AutoBuso then
        local busoValue = LP:FindFirstChild("Buso")
        if busoValue and busoValue.Value < Config.BusoThreshold * 10 then
            Fire("Buso")
        end
    end
    
    -- Position handling
    if Config.BringMobs then
        thrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 5)
    else
        hrp.CFrame = thrp.CFrame * CFrame.new(0, 0, 5)
    end
    
    -- Attack with tool
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        Fire("Combat", target)
    end
    
    return true
end

function Zuncodex:CombatLoop()
    -- Check if combat is enabled
    if not Config.CombatEnabled and not Config.KillAura then
        return
    end
    
    -- Cooldown check (FIXED: Prevent spam)
    if not CanAttack() then
        return
    end
    
    if Config.KillAura then
        -- Kill all in range
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            local npcsFolder = WS:FindFirstChild("Npcs")
            if npcsFolder then
                for _, npc in pairs(npcsFolder:GetChildren()) do
                    local hum = npc:FindFirstChild("Humanoid")
                    local nrp = npc:FindFirstChild("HumanoidRootPart")
                    
                    if hum and nrp and hum.Health > 0 then
                        local dist = (nrp.Position - hrp.Position).Magnitude
                        if dist <= Config.AuraRange then
                            self:AttackTarget(npc)
                        end
                    end
                end
            end
        end
    elseif Config.CombatEnabled then
        -- Normal auto farm
        local target = self:FindBestTarget()
        if target then
            self:AttackTarget(target)
        end
    end
    
    SetAttackCooldown()
end

-- Auto Stats (Fixed: With cooldown)
function Zuncodex:AutoStatsLoop()
    if not Config.StatsAuto then return end
    
    -- Cooldown check (only run every 2 seconds)
    if tick() - LastStatsTime < 2 then return end
    
    local stats = LP:FindFirstChild("stats")
    if not stats then return end
    
    local points = stats:FindFirstChild("Points")
    if not points or not points:IsA("IntValue") then return end
    if points.Value <= Config.StatsKeep then return end
    
    local allocPoints = points.Value - Config.StatsKeep
    if allocPoints <= 0 then return end
    
    -- Build allocation list
    local allocations = {}
    if Config.StatsMelee then table.insert(allocations, "Melee") end
    if Config.StatsDef then table.insert(allocations, "Defense") end
    if Config.StatsSword then table.insert(allocations, "Sword") end
    if Config.StatsGun then table.insert(allocations, "Gun") end
    
    if #allocations == 0 then return end
    
    local perStat = math.floor(allocPoints / #allocations)
    
    for _, stat in ipairs(allocations) do
        Fire("AddPoint", stat, perStat)
    end
    
    LastStatsTime = tick()
end

-- Auto Raid (Fixed: With cooldown)
function Zuncodex:AutoRaidLoop()
    if not Config.RaidAuto then return end
    
    -- Cooldown check
    if tick() - LastRaidTime < 5 then return end
    
    local inRaidArea = WS:FindFirstChild("_RaidArea")
    
    if not inRaidArea then
        -- Not in raid, try to join
        if Config.RaidJoin then
            Fire("JoinRaid")
        end
    else
        -- In raid area
        if Config.RaidStart then
            Fire("StartRaid")
        end
    end
    
    LastRaidTime = tick()
end

-- Fruit Sniper (Optimized: Not scanning every frame)
local LastFruitScan = 0

function Zuncodex:FruitSniperLoop()
    if not Config.FruitSniper then return end
    
    -- Only scan every 3 seconds (optimization)
    if tick() - LastFruitScan < 3 then return end
    
    local char = LP.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Scan for fruits
    for _, obj in pairs(WS:GetDescendants()) do
        if obj:IsA("Tool") then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                local distance = (handle.Position - hrp.Position).Magnitude
                
                if distance <= Config.SniperRange then
                    -- Notify
                    if Config.FruitNotify then
                        SG:SetCore("ChatMakeSystemMessage", {
                            Text = "[Zuncodex] 🍎 Found: " .. obj.Name .. " (" .. math.floor(distance) .. "m)",
                            Color = Color3.fromRGB(0, 255, 0)
                        })
                    end
                    
                    -- Auto store
                    if Config.AutoStore then
                        hrp.CFrame = handle.CFrame
                    end
                end
            end
        end
    end
    
    LastFruitScan = tick()
end

