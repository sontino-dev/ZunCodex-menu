function Zuncodex:GetCurrentQuestInfo()
    local data = LocalPlayer:FindFirstChild("Data") or LocalPlayer:FindFirstChild("playerstats")
    if data then
        local currentQuest = data:FindFirstChild("CurrentQuest")
        local questTarget = data:FindFirstChild("QuestTarget")
        local questNPC = data:FindFirstChild("QuestNPC")
        
        if currentQuest then
            return questNPC and questNPC.Value, questTarget and questTarget.Value, currentQuest.Value
        end
    end
    return nil, nil, nil
end

function Zuncodex:CheckAndAcceptQuest()
    local progress = self:GetQuestProgress()
    if progress and progress.Current >= progress.Required then
        self:CompleteCurrentQuest()
        safeWait(0.5)
        self:AcceptNearestQuest()
    end
end

function Zuncodex:AcceptNearestQuest()
    local nearestNPC, dist = self:FindNearestQuestNPC(100)
    if nearestNPC then
        if self.Remotes.InteractNPC then
            self.Remotes.InteractNPC:FireServer(nearestNPC)
        end
        self:Log("📜 Accepted quest from: " .. nearestNPC.Name)
    end
end

function Zuncodex:GetQuestProgress()
    local data = LocalPlayer:FindFirstChild("Data") or LocalPlayer:FindFirstChild("playerstats")
    if data then
        local progress = data:FindFirstChild("QuestProgress")
        local required = data:FindFirstChild("QuestRequired")
        
        if progress and required then
            return {
                Current = progress.Value,
                Required = required.Value
            }
        end
    end
    return nil
end

function Zuncodex:CompleteCurrentQuest()
    if self.Remotes.CompleteQuest then
        self.Remotes.CompleteQuest:FireServer()
    end
end

function Zuncodex:TeleportToQuestNPC(npcName)
    local npcsContainer = workspace:FindFirstChild("Npcs") or workspace:FindFirstChild("NPCs")
    if not npcsContainer then return false end
    
    for _, npc in ipairs(npcsContainer:GetChildren()) do
        if npc.Name:find(npcName) or npcName:find(npc.Name) then
            local root = npc:FindFirstChild("HumanoidRootPart")
            if root then
                self:TeleportTo(root.Position + Vector3.new(3, 0, 0))
                return true
            end
        end
    end
    return false
end

function Zuncodex:FindQuestTarget(targetName)
    -- FIX #15: Verificar que workspace.Enemies existe
    local enemiesContainer = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Enemies")
    if not enemiesContainer then return nil end
    
    for _, enemy in ipairs(enemiesContainer:GetChildren()) do
        if enemy.Name:find(targetName) or targetName:find(enemy.Name) then
            local humanoid = enemy:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                return enemy
            end
        end
    end
    return nil
end

