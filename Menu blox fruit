    ind.Size = UDim2.new(0, 16, 0, 16)
    ind.Position = UDim2.new(0, 3, 0.5, -8)
    ind.BackgroundColor3 = Color3.fromRGB(255,255,255)
    ind.Parent = btn
    
    local ic = Instance.new("UICorner")
    ic.CornerRadius = UDim.new(0, 8)
    ic.Parent = ind
    
    -- Get initial state
    local state = Config[configKey] or false
    
    local function update()
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            ind.Position = UDim2.new(0, 21, 0.5, -8)
        else
            btn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            ind.Position = UDim2.new(0, 3, 0.5, -8)
        end
    end
    update()
    
    btn.MouseButton1Click:Connect(function()
        state = not state
        Config[configKey] = state
        update()
        Chat(label .. ": " .. tostring(state), Color3.fromRGB(200,200,200))
    end)
    
    return f
end

