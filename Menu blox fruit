-- Find Enemy Function (From xHeptc pattern - WORKING!)
function FindEnemy()
    local char = LP.Character
    if not char then return nil end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    -- Try Enemies folder first (Sea 1/2/3 pattern)
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, enemy in pairs(enemiesFolder:GetChildren()) do
            if enemy:IsA("Model") then
                local hum = enemy:FindFirstChild("Humanoid")
                local ehrp = enemy:FindFirstChild("HumanoidRootPart")
                
                if hum and ehrp and hum.Health > 0 then
                    local dist = (ehrp.Position - hrp.Position).Magnitude
                    
                    if dist <= Config.AttackDist then
                        return enemy
                    end
                end
            end
        end
    end
    
    -- Try Npcs folder (alternative)
    local npcsFolder = workspace:FindFirstChild("Npcs")
    if npcsFolder then
        for _, npc in pairs(npcsFolder:GetChildren()) do
            local hum = npc:FindFirstChild("Humanoid")
            local nrp = npc:FindFirstChild("HumanoidRootPart")
            
            if hum and nrp and hum.Health > 0 then
                local dist = (nrp.Position - hrp.Position).Magnitude
                
                if dist <= Config.AttackDist then
                    return npc
                end
            end
        end
    end
    
    return nil
end

