-- FIX #21: Custom string.split for Lua 5.1 compatibility
-- ============================================================
local function split(str, separator)
    if not str or type(str) ~= "string" then return {} end
    separator = separator or "%s"
    local t = {}
    for str in string.gmatch(str..separator, "(.-)"..separator) do
        table.insert(t, str)
    end
    return t
end

-- Compatibility: Override string.split if not exists
if not string.split then
    string.split = split
end

