-- Module Farm
local Farm = {}

function Farm:Start()
    getgenv().JJJ.State.Farming = true
    spawn(function()
        while getgenv().JJJ.Settings.AutoFarm and getgenv().JJJ.State.Farming do
            local target
            if getgenv().JJJ.Settings.FarmMode == "Nearest" then
                target = Utils.GetNearestMob()
            elseif getgenv().JJJ.Settings.FarmMode == "Boss" then
                target = Utils.GetNearestBoss()
            else
                target = Utils.GetNearestMob()
            end
            if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 then
                -- di chuyển
                Utils.TeleportTo(target.HumanoidRootPart.CFrame)
                AntiBan:HumanDelay()
                -- tấn công
                local weapon = LP.Character:FindFirstChild(getgenv().JJJ.Settings.SelectedWeapon)
                if weapon and weapon:FindFirstChild("Activate") then
                    weapon.Activate:FireServer()
                end
                -- M1
                local vm = game:GetService("VirtualInputManager")
                vm:SendMouseButtonEvent(0, 0, true, game, 1)
                task.wait(0.05)
                vm:SendMouseButtonEvent(0, 0, false, game, 1)
                AntiBan:HumanDelay()
            else
                task.wait(0.5)
            end
            AntiBan:RandomPause()
            task.wait()
        end
    end)
end

