-- World modifications
function ZuncodexV5_1:UpdateWorld()
    -- Remove water
    if self.Config.Misc.RemoveWater then
        for _, desc in pairs(Workspace:GetDescendants()) do
            if desc:IsA("Terrain") then
                desc.WaterWaveSize = 0
                desc.WaterWaveSpeed = 0
                desc.WaterReflectance = 0
                desc.WaterTransparency = 1
            elseif desc.Name == "Water" and desc:IsA("Part") then
                desc.Transparency = 1
            end
        end
    end
    
    -- Remove clouds
    if self.Config.Misc.RemoveClouds then
        if Lighting:FindFirstChild("Clouds") then
            Lighting.Clouds:Destroy()
        end
    end
    
    -- Fullbright
    if self.Config.Misc.Fullbright then
        Lighting.Brightness = 2
        Lighting.EnvironmentBrightness = 1
        Lighting.GlobalShadows = false
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    else
        Lighting.Brightness = 1
        Lighting.EnvironmentBrightness = 0
        Lighting.GlobalShadows = true
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    end
end

