-- ==================== PHẦN 3: TIỆN ÍCH (UTILS) ====================
-- ~ 350 dòng

local Utils = {}

function Utils:RandomDelay(min, max)
    if self.AntiBan.Enabled then
        return math.random(min * 100, max * 100) / 100
    else
        return min
    end
end

function Utils:GetNearestMob()
    local nearest = nil
    local dist = math.huge
    for _, v in pairs(Workspace.Enemies:GetChildren()) do
        if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
            local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
            if d < dist then
                nearest = v
                dist = d
            end
        end
    end
    return nearest
end

function Utils:GetNearestBoss()
    local nearest = nil
    local dist = math.huge
    for _, v in pairs(Workspace.Bosses:GetChildren()) do
        if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
            local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
            if d < dist then
                nearest = v
                dist = d
            end
        end
    end
    return nearest
end

function Utils:GetIslandCFrame(name)
    local islands = {
        Jungle = CFrame.new(-1234, 80, 567),
        PirateVillage = CFrame.new(-789, 80, 234),
        MarineFort = CFrame.new(456, 80, -123),
        Skylands = CFrame.new(2345, 800, 1234),
        Prison = CFrame.new(-3456, 80, 789),
        Colosseum = CFrame.new(1234, 80, -567),
        Magma = CFrame.new(678, 80, -901),
        FishmanIsland = CFrame.new(-234, 80, 3456),
        Sea2_Kingdom = CFrame.new(4567, 80, 2345),
        Sea2_GreatTree = CFrame.new(5678, 800, 3456),
        Sea3_Island = CFrame.new(6789, 80, 4567),
        Sea3_Hydra = CFrame.new(7890, 80, 5678),
        Sea3_SeaOfTreats = CFrame.new(8901, 80, 6789),
    }
    return islands[name] or CFrame.new(0, 80, 0)
end

function Utils:TeleportTo(cframe)
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LP.Character.HumanoidRootPart
    local tween = TweenService:Create(hrp, TweenInfo.new(
        (hrp.Position - cframe.Position).Magnitude / getgenv().JJJ.Settings.TweenSpeed,
        Enum.EasingStyle.Linear
    ), {CFrame = cframe})
    tween:Play()
    return tween
end

function Utils:HasItem(itemName)
    if LP.Backpack:FindFirstChild(itemName) then return true end
    if LP.Character:FindFirstChild(itemName) then return true end
    return false
end

function Utils:GetCurrentSea()
    local pos = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character.HumanoidRootPart.Position
    if not pos then return 1 end
    if pos.X > 3000 and pos.X < 6000 then return 2 end
    if pos.X > 6000 then return 3 end
    return 1
end

function Utils:FindInWorkspace(name)
    return Workspace:FindFirstChild(name) or Workspace:FindFirstChild(name.."s")
end

function Utils:FireClickDetector(obj)
    if obj and obj:FindFirstChild("ClickDetector") then
        fireclickdetector(obj.ClickDetector)
    end
end

