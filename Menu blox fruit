        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
            local humanoid = obj.Humanoid
            local root = obj:FindFirstChild("HumanoidRootPart")
            
            if humanoid and root and humanoid.Health > 0 then
                local objName = obj.Name:lower()
                local searchName = bossName:lower()
                
                if objName:find(searchName) or searchName:find(objName:sub(1, math.min(#searchName, #objName))) then
                    local dist = (myPos - root.Position).Magnitude
                    if dist <= range then
                        return obj, dist
                    end
                end
            end
        end
    end
    
    return nil, nil
end

function Zuncodex:FindAnySelectedBoss(range)
    range = range or math.huge
    local closestBoss = nil
    local closestDist = math.huge -- FIX #4: Declarar variable correctamente
    
    for bossName, selected in pairs(self.Config.SelectedBosses) do
        if selected then
            local boss, dist = self:FindBoss(bossName, range)
            if boss and dist < closestDist then
                closestBoss = boss
                closestDist = dist
            end
        end
    end
    
    return closestBoss, closestDist
end

function Zuncodex:ShouldWaitForRespawn(bossName)
    local timeSinceKill = tick() - self.LastBossKillTime
    local waitTime = self.Config.BossRespawnWait or 300
    
    if timeSinceKill < waitTime then
        return true, waitTime - timeSinceKill
    end
    return false, 0
end

