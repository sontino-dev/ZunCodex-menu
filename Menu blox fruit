function Zuncodex:StartAutoCollectDrops()
    self:AddConnection("AutoCollect", RunService.Heartbeat:Connect(function()
        local myPos = self:GetPosition()
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Part") or obj:IsA("MeshPart") then
                local name = obj.Name:lower()
                if name:find("drop") or name:find("loot") or name:find("money") or 
                   name:find("fragment") or name:find("material") then
                    local dist = (myPos - obj.Position).Magnitude
                    if dist < 50 then
                        -- FIX #7: Wrap en pcall
                        pcall(function()
                            if firetouchinterest then
                                firetouchinterest(obj, self:GetRootPart(), 0)
                                firetouchinterest(obj, self:GetRootPart(), 1)
                            end
                        end)
                    end
                end
            end
        end
    end))
    
    self:Log("▶️ Auto Collect Drops started")
end

