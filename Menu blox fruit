-- Fly System (Basic but working)
local flyConn = nil
local flying = false
local bodyVel = nil

local function ToggleFly()
    local char = LP.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if Config.Fly then
        if not flying then
            flying = true
            
            bodyVel = Instance.new("BodyVelocity")
            bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bodyVel.Velocity = Vector3.new(0, 0, 0)
            bodyVel.Parent = hrp
            
            flyConn = RunService.RenderStepped:Connect(function()
                if not Config.Fly then
                    ToggleFly()
                    return
                end
                
                local c = LP.Character
                if not c then return end
                
                local h = c:FindFirstChild("HumanoidRootPart")
                if not h or not bodyVel then return end
                
                local cf = workspace.CurrentCamera.CFrame
                local mv = Vector3.new(0, 0, 0)
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv = mv + cf.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv = mv - cf.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv = mv - cf.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv = mv + cf.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.new(0, 1, 0) end
                
                if mv.Magnitude > 0 then
                    mv = mv.Unit * Config.FlySpeed
                end
                
                bodyVel.Velocity = mv
            end)
            
            Chat("Fly enabled", Color3.fromRGB(0,255,0))
        end
    else
        flying = false
        
        if flyConn then
            flyConn:Disconnect()
            flyConn = nil
        end
        
        if bodyVel then
            bodyVel:Destroy()
            bodyVel = nil
        end
        
        Chat("Fly disabled", Color3.fromRGB(255,200,0))
    end
end

