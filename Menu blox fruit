function Zuncodex:GetMoonPhase()
    local currentTime = os.time()
    local moonCycle = 29.53 * 24 * 60 * 60
    local phase = (currentTime % moonCycle) / moonCycle
    
    local phases = {"New Moon", "Waxing Crescent", "First Quarter", "Waxing Gibbous", 
                     "Full Moon", "Waning Gibbious", "Last Quarter", "Waning Crescent"}
    local phaseIndex = math.floor(phase * 8) + 1
    if phaseIndex > 8 then phaseIndex = 8 end
    
    return phases[phaseIndex], phase
end

