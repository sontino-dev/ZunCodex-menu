-- Fruit Sniper System (NEW in V5.1)
function ZuncodexV5_1:FruitSniper()
    if not self.Config.Fruit.SniperEnabled then return end
    
    local localChar = LocalPlayer.Character
    if not localChar then return end
    
    local localHRP = localChar:FindFirstChild("HumanoidRootPart")
    if not localHRP then return end
    
    -- Find fruits in workspace
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Fruit" or obj:IsA("Tool") then
            -- Check if it's a devil fruit
            local handle = obj:FindFirstChild("Handle")
            if handle then
                local distance = (handle.Position - localHRP.Position).Magnitude
                
                if distance <= self.Config.Fruit.SniperRange then
                    -- Notify or teleport to fruit
                    if self.Config.Utility.Notifier then
                        StarterGui:SetCore("ChatMakeSystemMessage", {
                            Text = "[Zuncodex] Found Fruit: " .. obj.Name .. " at " .. math.floor(distance) .. "m!",
                            Color = Color3.fromRGB(0, 255, 0)
                        })
                    end
                    
                    -- If auto store, pick up fruit
                    if self.Config.Fruit.AutoStore then
                        -- Move to fruit
                        localHRP.CFrame = handle.CFrame
                        
                        -- Try to pick up (would use touch interest if available)
                        if fireTouchInterest then
                            firetouchinterest(handle, localHRP, 0)
                            firetouchinterest(handle, localHRP, 1)
                        end
                    end
                end
            end
        end
    end
end

