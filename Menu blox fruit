function Zuncodex:FindNearestFruit(range)
    range = range or self.Config.FruitSniperRange or 10000
    local nearest = nil
    local nearestDist = math.huge
    local myPos = self:GetPosition()
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") and (obj.Name:find("Fruit") or obj.Name:find("fruit")) then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                local dist = (myPos - handle.Position).Magnitude
                if dist <= range and dist < nearestDist then
                    if self:FruitMeetsThreshold(obj) then
                        nearest = obj
                        nearestDist = dist
                    end
                end
            end
        end
    end
    
    return nearest, nearestDist
end

function Zuncodex:FruitMeetsThreshold(fruit)
    if not self.Config.FruitPriceThreshold or self.Config.FruitPriceThreshold <= 0 then
        return true
    end
    
    local fruitValue = self:GetFruitValue(fruit.Name)
    return fruitValue >= self.Config.FruitPriceThreshold
end

function Zuncodex:GetFruitValue(fruitName)
    local fruitValues = {
        ["Flame"] = 2500000, ["Ice"] = 2600000, ["Light"] = 2700000,
        ["Rubber"] = 2800000, ["Gravity"] = 2900000, ["Dough"] = 10000000,
        ["Dragon"] = 15000000, ["Venom"] = 3200000, ["Shadow"] = 3300000,
        ["Portal"] = 3400000, ["Phoenix"] = 3800000, ["Control"] = 5000000,
        ["Spirit"] = 5200000, ["Spider"] = 3500000, ["Sound"] = 3600000,
        ["Love"] = 3700000, ["Leo"] = 6000000, ["Treasure"] = 1000000,
        ["Spring"] = 1800000, ["Smoke"] = 1500000, ["Spin"] = 1900000,
        ["Bird"] = 2100000, ["Blizzard"] = 2400000, ["Magma"] = 2300000,
        ["Quake"] = 2200000, ["Chop"] = 900000, ["Old"] = 800000,
        ["Diamond"] = 2000000,
    }
    
    for name, value in pairs(fruitValues) do
        if fruitName:find(name) then
            return value
        end
    end
    
    return 0
end

function Zuncodex:StartFruitSniper()
    self:AddConnection("FruitSniper", RunService.Heartbeat:Connect(function()
        if not self.Config.FruitSniper then return end
        
        local fruit, dist = self:FindNearestFruit()
        
        if fruit then
            local handle = fruit:FindFirstChild("Handle")
            if handle then
                self:TeleportTo(handle.Position)
                self:GrabFruit(fruit)
                
                self:Log("🍎 Found fruit: " .. fruit.Name .. " (Distance: " .. math.floor(dist) .. ")")
                
                if self.Config.WebhookEnabled and self.Config.WebhookURL ~= "" then
                    self:SendWebhook("Fruit Found", "**" .. fruit.Name .. "** spawned!\nDistance: " .. math.floor(dist) .. " studs\nValue: ~" .. self:GetFruitValue(fruit.Name))
                end
            end
        end
    end))
    
    self:Log("▶️ Fruit Sniper started")
end

function Zuncodex:StopFruitSniper()
    self:RemoveConnection("FruitSniper")
    self:Log("⏹️ Fruit Sniper stopped")
end

function Zuncodex:GrabFruit(fruit)
    -- FIX #7: Wrap firetouchinterest en pcall
    pcall(function()
        local handle = fruit:FindFirstChild("Handle")
        if handle then
            if firetouchinterest then
                firetouchinterest(handle, self:GetRootPart(), 0)
                firetouchinterest(handle, self:GetRootPart(), 1)
            end
        end
        
        if self.Remotes.GrabFruit or self.Remotes.InteractNPC then
            (self.Remotes.GrabFruit or self.Remotes.InteractNPC):FireServer(fruit)
        end
    end)
end

