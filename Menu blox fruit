function Zuncodex:StartFightingStyleMastery(styleName)
    if not self.Config.FightingStyleMastery[styleName] then return end
    
    self:AddConnection("Mastery_" .. styleName, RunService.Heartbeat:Connect(function()
        if not self.Config.FightingStyleMastery[styleName] then return end
        
        local target = self:FindMasteryTarget(styleName)
        if target then
            local root = target:FindFirstChild("HumanoidRootPart")
            if root then
                self:TeleportTo(root.Position + Vector3.new(0, 3, 0))
                self:AttackTarget(target)
            end
        end
    end))
    
    self:Log("▶️ " .. styleName .. " mastery farming started")
end

function Zuncodex:StopFightingStyleMastery(styleName)
    self:RemoveConnection("Mastery_" .. styleName)
    self:Log("⏹️ " .. styleName .. " mastery farming stopped")
end

function Zuncodex:FindMasteryTarget(styleName)
    local targets = {
        Superhuman = {"Fighter", "Trainer", "Master"},
        Godhuman = {"Ancient", "Elder", "Legend"},
        DragonTalon = {"Dragon", "Martial"},
        ElectricClaw = {"Electric", "Thunder", "Lightning"},
        SharkmanKarate = {"Shark", "Fish", "Sea"},
        DeathStep = {"Fire", "Burn", "Death"},
        SanguineArt = {"Blood", "Vampire", "Dark"}
    }
    
    local keywords = targets[styleName] or {}
    local myPos = self:GetPosition()
    local nearest = nil
    local nearestDist = math.huge
    
    local npcsContainer = workspace:FindFirstChild("Npcs") or workspace:FindFirstChild("NPCs")
    if not npcsContainer then return nil end
    
    for _, npc in ipairs(npcsContainer:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc:FindFirstChild("HumanoidRootPart") then
            local humanoid = npc.Humanoid
            if humanoid.Health > 0 then
                for _, keyword in ipairs(keywords) do
                    if npc.Name:find(keyword) then
                        local root = npc.HumanoidRootPart
                        local dist = (myPos - root.Position).Magnitude
                        if dist < nearestDist then
                            nearest = npc
                            nearestDist = dist
                        end
                        break
                    end
                end
            end
        end
    end
    
    return nearest
end

